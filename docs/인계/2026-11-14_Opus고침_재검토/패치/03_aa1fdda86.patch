   target: string;
+  /** 이 줄에 목표 칸이 있었는가 (값이 없음이어도 true. 목표 칸을 끈 구성이거나 칸이 모자라면 false) */
+  hasTarget: boolean;
   /** 지금 주인공과 같이 있는 이름 있는 인물들 (8칸 상태창의 동행 칸. 칸이 없거나 없음이면 빈 목록) */
