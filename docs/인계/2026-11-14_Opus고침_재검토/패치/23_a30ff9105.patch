     .replace(/^Use 썰, 창작 괴담[^\n]*$/m, SALMON_TOPICS)
-    // 괴담갤에서 물려받은 DC 말투 기본 문장은 거래 게시판과 맞지 않아 뺀다 (사용자 2026-11-14)
