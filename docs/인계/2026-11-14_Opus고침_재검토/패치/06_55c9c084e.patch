+// 전수검사 11-13 기록 고침: 일지 시각 순서, 연대기 사건 줄 자리, 보고서 호감 계수, 종료 응답 뒤 보고서 다시 셈
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { build } from 'esbuild';
+import { mkdtemp } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+const dir = await mkdtemp(join(tmpdir(), 'goei-fixjournal-'));
+await build({
+  entryPoints: ['src/core/journal/index.ts'],
+  outdir: dir, outbase: 'src', bundle: true, platform: 'node', format: 'esm', outExtension: { '.js': '.mjs' }, logLevel: 'silent',
+  loader: { '.txt': 'text', '.md': 'text' },
+});
+const J = await import(pathToFileURL(join(dir, 'core/journal/index.mjs')));
+
+const PEOPLE_KEY = 'goeiPeopleV1';
+const emptyStore = () => ({ schema: 1, people: {}, factions: {}, docs: {}, log: [], folded: {}, read: {}, pending: {}, ignored: [] });
+const msgs = (...ids) => ids.map((id, i) => ({ role: i % 2 ? 'char' : 'user', data: i % 2 ? `응답 [▣|2025.01.0${Math.ceil(i / 2)}|03:00 AM|☀️|4°C|종로|없음]` : '계속', chatId: id }));
+const cue = (who, cueName, anchor, seq) => ({ id: `c${who}${anchor}${seq}`, anchor, seq, src: 'manual', who, kind: 'cue', cue: cueName, reason: '' });
+const person = (name) => ({ name, faction: 'A00', seeded: { from: 'none', at: '' }, slots: {}, affinity: { base: 0 }, address: { toUser: '요원', register: '반말' }, express: 1, aliases: [] });
+const row = (extra) => ({ id: `j${extra.name}`, kind: 'an', name: '?', loc: '', at: null, since: null, born: null, idx: 1, anchor: 'c1', mine: true, cause: 'model', agents: [], result: '', ...extra });
+const report = (extra) => ({ id: 'r1', no: 'RPT-0101-01', full: true, mine: true, kind: 'in', cause: 'model', head: { name: '사건', loc: '', born: null, since: null, at: null, duration: null }, trail: [], agents: [], result: '', idx: 3, anchor: 'c2', fromKey: 'c1', savedAt: '2025-01-01T00:00:00Z', people: [], wallet: [], balance: 1000, ...extra });
+
+test('일지: 종료 시각이 최근인 줄이 위, 같은 시각은 나중 저장이 위, 시각 없음은 맨 뒤', () => {
+  const rows = [{ n: 'C', at: 100 }, { n: 'B', at: 300 }, { n: 'N', at: null }, { n: 'A', at: 200 }, { n: 'D', at: 300 }];
+  assert.deepEqual(J.journalNewestFirst(rows).map((r) => r.n), ['D', 'B', 'A', 'C', 'N']);
+});
+
+test('연대기: 앞 메시지를 지워도 사건 줄은 열쇠로 지금 자리를 찾는다', () => {
+  const message = msgs('u2', 'c2', 'u3', 'c3'); // u1·c1 을 지운 뒤
+  const rows = [row({ name: '내 사건', idx: 3, anchor: 'c2' })];
+  const chat = { message, scriptstate: { $goei_journal: JSON.stringify({ v: 1, rows }) }, [PEOPLE_KEY]: emptyStore() };
+  const [e] = J.buildChronicle(chat, []);
+  assert.equal(e.pos, 1);
+  assert.equal(e.day, '2025.01.01');
+  // 열쇠가 없어진 줄은 저장 번호 그대로
+  const gone = { ...chat, scriptstate: { $goei_journal: JSON.stringify({ v: 1, rows: [row({ name: '옛', idx: 3, anchor: 'zz' })] }) } };
+  assert.equal(J.buildChronicle(gone, [])[0].pos, 3);
+});
+
+test('보고서 다시 셈: 종료 응답의 가계부 줄·호감 계기가 뒤에 적혀도 그 응답의 보고서에 들어간다', () => {
+  const message = msgs('u1', 'c1', 'u2', 'c2');
+  const store = { ...emptyStore(), people: { 사장: person('사장') }, log: [cue('사장', '도움', 'c2', 0)] };
+  const wallet = { start: 1000, log: [{ id: 'w1', anchor: 'c2', amount: 300, memo: '상태창 잔고', src: 'story', at: '' }] };
+  const chat = { message, scriptstate: { $goei_reports: JSON.stringify({ v: 1, items: [report({}), report({ id: 'r2', idx: 1, anchor: 'c1' })] }), $st_wallet: JSON.stringify(wallet) }, [PEOPLE_KEY]: store };
+  const v = J.refreshClosures(chat, 3);
+  assert.ok(v);
+  const items = JSON.parse(v.$goei_reports).items;
+  assert.equal(items[0].balance, 1300);
+  assert.deepEqual(items[0].wallet.map((t) => t.amount), [300]);
+  assert.deepEqual(items[0].people.map((p) => p.who), ['사장']);
+  // 다른 메시지에서 끝난 보고서는 그대로
+  assert.deepEqual(items[1].people, []);
+  assert.equal(items[1].balance, 1000);
+  // 이미 맞으면 저장하지 않는다
+  assert.equal(J.refreshClosures({ ...chat, scriptstate: { ...chat.scriptstate, ...v } }, 3), null);
+  // 간이 보고서·fromKey 없는 옛 보고서는 건드리지 않는다
+  const old = { ...chat, scriptstate: { ...chat.scriptstate, $goei_reports: JSON.stringify({ v: 1, items: [report({ fromKey: undefined }), report({ id: 'r3', mine: false, full: false })] }) } };
+  assert.equal(J.refreshClosures(old, 3), null);
+});
+
+test('보고서 호감: 성격 계수를 넣어 인물 기록 화면과 같은 수치', () => {
+  const message = msgs('u1', 'c1', 'u2', 'c2');
+  const store = { ...emptyStore(), people: { 무명씨: person('무명씨'), 게슈간: person('게슈간') }, log: [cue('무명씨', '도움', 'c2', 0), cue('게슈간', '도움', 'c2', 0)] };
+  const chat = { message, scriptstate: { $goei_reports: JSON.stringify({ v: 1, items: [report({})] }) }, [PEOPLE_KEY]: store };
+  const people = JSON.parse(J.refreshClosures(chat, 3).$goei_reports).items[0].people;
+  const d = Object.fromEntries(people.map((p) => [p.who, p.delta]));
+  assert.equal(d['무명씨'], 3); // 기본 자료에 없는 사람은 계수 1
+  assert.equal(d['게슈간'], 1.5); // 게슈간 open 0.5 (relations-base.json)
+});
diff --git a/tests/fix-malls.test.mjs b/tests/fix-malls.test.mjs
new file mode 100644
index 0000000000..d71918cf08
--- /dev/null
+++ b/tests/fix-malls.test.mjs
@@ -0,0 +1,93 @@
+// 전수검사 11-13: 망상홈쇼핑·쇼핑몰·포인트 장부 고친 것 (malls#2~#8, settings#6)
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { build } from 'esbuild';
+
+const out = await build({
+  stdin: {
+    contents: `
+      export { hsVars, hsSettings, parseChat, turnStep, hsNumVars, HS_NUM } from './src/core/homeshop';
+      export { HS_PAIRS } from './src/core/setdef/homeshop';
+      export { shopGiveOn } from './src/core/shopfn';
+      export { dropDoubleSync, syncPointsToStatus, readPoints } from './src/core/points';
+      export { mergeLate } from './src/ui/malls';
+    `,
+    resolveDir: process.cwd(), loader: 'ts',
+  },
+  bundle: true, format: 'esm', write: false, platform: 'browser', target: 'es2022', charset: 'utf8', loader: { '.txt': 'text' }, logLevel: 'silent',
+});
+const M = await import(`data:text/javascript;base64,${Buffer.from(out.outputFiles[0].text).toString('base64')}`);
+
+test('malls#2: 망상홈쇼핑 맥락 반영은 제 값이 있으면 그 값 (가게 표와 같다)', () => {
+  const on = { $sh_ctx: '0', $hs_sh_ctx: '1' };
+  assert.equal(M.hsSettings(on).shop.context, true);
+  assert.equal(M.hsSettings(on).shop.context, M.shopGiveOn(on, 'hs', 'ctx'));
+  assert.equal(M.hsSettings({ $hs_sh_ctx: '0' }).shop.context, false);
+  // 제 값이 없으면 기본 상점 값
+  assert.equal(M.hsSettings({ $sh_ctx: '0' }).shop.context, false);
+  assert.equal(M.hsVars({ $sh_ctx: '0' }).$sh_ctx, '0');
+  assert.equal(M.hsVars({}).$sh_ctx, undefined);
+  // 다른 공유 값은 새지 않는다
+  assert.equal(M.hsVars({ $sh_turns: '3', $hs_sh_turns: '9' }).$sh_turns, '3');
+});
+
+test('malls#3: 채팅 머리줄에 상품명·꾸밈이 붙어도 부로 나눈다. 「|」 있는 줄은 늘 채팅', () => {
+  const r = M.parseChat('공용|안녕\n#1 꿈 베개\n닉|와 싸다\n**#2**: 거울\n닉2|무섭다\n#7번손님|말');
+  assert.deepEqual(r.shared, [{ nick: '공용', text: '안녕' }]);
+  assert.equal(r.parts.length, 2);
+  assert.deepEqual(r.parts[0], [{ nick: '닉', text: '와 싸다' }]);
+  assert.deepEqual(r.parts[1].map((x) => x.nick), ['닉2', '#7번손님']);
+  // 머리 없는 응답은 전부 공용
+  assert.equal(M.parseChat('a|b\nc|d').parts.length, 0);
+});
+
+test('malls#4: 되돌림 줄은 산 줄을 먼저 짝짓는다 (리롤로 죽은 줄과 짝지어 산 줄을 남기지 않는다)', () => {
+  const e = (id, anchor, amount, memo = '상태창 포인트') => ({ id, anchor, amount, memo, src: 'story', at: '' });
+  const w = { ...M.readPoints({}), log: [e('ps_N', 'N', 5000), e('w_1', 'N', 5000, '정산'), e('ps_N1a', 'N1a', -5000), e('ps_N1b', 'N1b', -5000)] };
+  const healed = M.dropDoubleSync(w, new Set(['N', 'N1b']));
+  assert.deepEqual(healed.log.map((x) => x.id), ['w_1', 'ps_N1a']);
+  // 산 줄이 없으면 지금처럼 아무 줄이나
+  const w2 = { ...w, log: [e('ps_N', 'N', 5000), e('w_1', 'N', 5000, '정산'), e('ps_zz', 'zz', -5000)] };
+  assert.deepEqual(M.dropDoubleSync(w2, new Set(['N'])).log.map((x) => x.id), ['w_1']);
+  assert.deepEqual(M.dropDoubleSync(w2).log.map((x) => x.id), ['w_1']);
+});
+
+test('malls#7: 턴 넘김은 판정만 (수동 여부와 무관), 다시 굴리기·끝난 편성은 안 넘긴다', () => {
+  const show = { loaded: true, key: 'k', title: '', parts: [{}, {}, {}], chat: [], at: 0, prev: [], tk: 't1' };
+  assert.deepEqual(M.turnStep(show, true, 't2'), { ...show, at: 1, tk: 't2' });
+  assert.equal(M.turnStep(show, true, 't1'), null);
+  assert.equal(M.turnStep(show, false, 't2'), null);
+  assert.equal(M.turnStep({ ...show, at: 3 }, true, 't2'), null);
+  assert.equal(M.turnStep({ ...show, tk: undefined }, true, 't2'), null);
+});
+
+test('malls#8: 답을 기다리는 동안 산 물건·취소한 판매는 되돌리지 않는다', () => {
+  const it = (id, sold) => ({ id, name: id, price: 1, desc: '', effect: '', ...(sold ? { sold: true, soldKey: 'c1' } : {}) });
+  const base = { shop: '', owner: '', key: '', loaded: true, identity: { sells: '', never: '', prices: '' }, items: [], talk: [], closed: false, prev: [], sell: null, sales: [] };
+  const st0 = { ...base, items: [it('a'), it('b')], sell: { itemId: 'x', name: 'x' } };
+  const now = { ...st0, items: [it('a', true), it('b')], sell: null };
+  // 문의 답: 진열은 그대로, 판매 카드 남음
+  const talk = M.mergeLate(now, { ...st0, talk: [{ who: 'owner', text: '응' }] }, st0);
+  assert.equal(talk.items.find((x) => x.id === 'a').sold, true);
+  assert.equal(talk.sell, null);
+  assert.equal(talk.talk.length, 1);
+  // 진열 새로 짜기: 산 물건이 새 진열에 없으면 팔린 채로 앞에 붙는다
+  const shelf = M.mergeLate(now, { ...st0, items: [it('c'), it('d')] }, st0);
+  assert.deepEqual(shelf.items.map((x) => [x.id, !!x.sold]), [['a', true], ['c', false], ['d', false]]);
+  // 그사이 바뀐 게 없으면 답 그대로
+  const same = { ...st0, items: [it('c')] };
+  assert.deepEqual(M.mergeLate(st0, same, st0), same);
+});
+
+test('settings#6: 최소가 최대를 넘으면 짝도 같이 맞춘다', () => {
+  const pair = (k) => Object.values(M.HS_PAIRS).find((p) => p.includes(k));
+  const K = (k) => M.HS_NUM[k].key;
+  assert.deepEqual(M.hsNumVars({ [K('cueMax')]: '5' }, 'cueMin', 8, pair('cueMin')), { [K('cueMin')]: '8', [K('cueMax')]: '8' });
+  assert.deepEqual(M.hsNumVars({ [K('cueMin')]: '9' }, 'cueMax', 4, pair('cueMax')), { [K('cueMax')]: '4', [K('cueMin')]: '4' });
+  // 넘지 않으면 한 칸만, 범위 밖은 잘라서
+  assert.deepEqual(M.hsNumVars({}, 'cueMin', 3, pair('cueMin')), { [K('cueMin')]: '3' });
+  assert.deepEqual(M.hsNumVars({}, 'cueMin', 99, pair('cueMin')), { [K('cueMin')]: '20', [K('cueMax')]: '20' });
+  // 짝 없는 칸
+  assert.deepEqual(M.hsNumVars({}, 'speed', 12, pair('speed')), { [K('speed')]: '12' });
+  assert.deepEqual(M.hsNumVars({}, 'nope', 1), {});
+});
diff --git a/tests/fix-people.test.mjs b/tests/fix-people.test.mjs
new file mode 100644
index 0000000000..b8d569120a
--- /dev/null
+++ b/tests/fix-people.test.mjs
@@ -0,0 +1,78 @@
+// 전수검사 11-13: 훅 심은 턴(진전 뒤), 호감 단계 일치(본편·Director·갱신기), 계기 자료 이름만
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { build } from 'esbuild';
+import { mkdtemp } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+const dir = await mkdtemp(join(tmpdir(), 'goei-fix-people-'));
+await build({
+  entryPoints: ['src/core/people/rhythm.ts', 'src/core/people/updater.ts', 'src/core/people/director.ts', 'src/core/people/request.ts', 'src/core/people/store.ts', 'src/core/people/types.ts', 'src/core/people/settings.ts', 'src/core/people/affinity.ts', 'src/core/people/base.ts'],
+  outdir: dir, outbase: 'src', bundle: true, platform: 'node', format: 'esm', outExtension: { '.js': '.mjs' }, logLevel: 'silent',
+});
+const mod = async (n) => import(pathToFileURL(join(dir, `core/people/${n}.mjs`)));
+const Rh = await mod('rhythm');
+const U = await mod('updater');
+const D = await mod('director');
+const R = await mod('request');
+const S = await mod('store');
+const T = await mod('types');
+const St = await mod('settings');
+const A = await mod('affinity');
+const B = await mod('base');
+
+const person = (name) => ({ name, faction: 'A00', seeded: { from: 'none', at: '' }, slots: {}, affinity: { base: 0 }, address: { toUser: '요원', register: '반말' }, express: 1, aliases: [], axes: T.DEFAULT_AXES(), axesFrom: 'default', patterns: [], candidates: {} });
+const chatOf = (n, who = '쟈알디') => ({ message: Array.from({ length: n * 2 }, (_, i) => ({ role: i % 2 ? 'char' : 'user', data: i % 2 ? `${who}가 ${(i + 1) / 2}번째로 말했다.` : `입력 ${i / 2 + 1}`, chatId: i % 2 ? `c${(i + 1) / 2}` : `u${i / 2 + 1}` })) });
+const entry = (id, text, anchor, extra = {}) => ({ id, text, src: 'story', anchor, seq: 1, quote: '말했다', ...extra });
+
+test('훅 시계: 진전(replaces)해도 심은 턴은 처음 심은 턴', () => {
+  const c = chatOf(10);
+  const live = S.liveness(c);
+  const store = T.emptyStore();
+  store.docs['rhythm:hook:편지'] = { type: 'rhythm', key: 'hook:편지', entries: [entry('h1', '[stage:seeded] [tier:mid] 편지', 'c2'), entry('h2', '[stage:hinted] [tier:mid] 봉투', 'c9', { replaces: 'h1' })] };
+  const k = Rh.rhythmClock(store, c, live);
+  const h = k.hooks.find((x) => x.key === 'hook:편지');
+  assert.equal(h.planted, 2);
+  assert.equal(h.age, 8);
+  assert.equal(h.last, 9);
+  assert.equal(h.sinceLast, 1);
+  assert.equal(h.due, true);
+  assert.equal(k.lastPlant, 2);
+  assert.equal(k.plantAllowed, true, '진전만으로는 새 훅 간격이 막히지 않음');
+  // 처음 항목이 취소되면 다음 살아 있는 사슬 항목 기준
+  store.docs['rhythm:hook:편지'].entries[0].void = true;
+  const k2 = Rh.rhythmClock(store, c, live);
+  assert.equal(k2.hooks.find((x) => x.key === 'hook:편지').planted, 9);
+});
+
+test('호감 단계: Director·갱신기도 성격 계수(temper)를 본편과 같이 쓴다', () => {
+  const name = '게슈간';
+  assert.notEqual(B.temperOf(name)?.open ?? 1, 1, '시험 인물은 temper 가 1이 아니어야');
+  const c = chatOf(12, name);
+  const live = S.liveness(c);
+  const store = T.emptyStore();
+  store.people[name] = person(name);
+  for (let k = 1; k <= 12; k++) store.log.push({ id: `cue${k}`, anchor: `c${k}`, seq: 0, src: 'story', who: name, kind: 'cue', cue: '헌신', reason: 'r' });
+  const settings = St.peopleSettings({ $pp_director: 'scene', $pp_rhythm: '0' });
+  const changes = S.liveChanges(store, live);
+  const want = A.affinityView(store.people[name], changes, 0, { temper: B.temperOf(name), speed: settings.speed, speedDown: settings.speedDown, turnCap: settings.turnCap }).stage;
+  const plain = A.affinityView(store.people[name], changes, 0, { turnCap: settings.turnCap }).stage;
+  assert.notEqual(want.label, plain.label, '계수 유무로 단계가 갈리는 경우');
+  const dir = D.buildDirector(c, store, [name], '입력', settings, {});
+  assert.equal(dir.data.people[0].affinity, want.label);
+  const input = U.buildUpdate(c, store, [23], { settings, system: 'S', values: {}, names: [{ name, aliases: [], titles: [] }], only: [name] });
+  const p = input.data.people.find((x) => x.name === name);
+  assert.equal(p.affinity_now, `${want.label}(${want.max})`);
+  const main = R.peopleBlockFor(c, { settings, store, sheetOf: () => null, temperOf: B.temperOf, people: [name] });
+  assert.ok(main.text.includes(want.label), '본편 블록도 같은 단계');
+});
+
+test('갱신기 자료 cues: 계기 이름만 (뜻은 지침 표)', () => {
+  const c = chatOf(2);
+  const store = T.emptyStore();
+  store.people.쟈알디 = person('쟈알디');
+  const input = U.buildUpdate(c, store, [3], { settings: St.peopleSettings({}), system: 'S', values: {}, names: [{ name: '쟈알디', aliases: [], titles: [] }] });
+  assert.deepEqual(input.data.cues, [...T.CUES]);
+});
diff --git a/tests/fix-pipeline.test.mjs b/tests/fix-pipeline.test.mjs
new file mode 100644
index 0000000000..9447f04ef4
--- /dev/null
+++ b/tests/fix-pipeline.test.mjs
@@ -0,0 +1,117 @@
+// 전수검사 11-13 고침: 보조 모델 이미지 태그의 생각 칸, 통합 요청 첨부, 참고 기록 고르기, 통합 응답 가르기
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { build } from 'esbuild';
+import { mkdtemp } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+const dir = await mkdtemp(join(tmpdir(), 'goei-fix-pipeline-'));
+await build({
+  entryPoints: ['src/core/asset.ts', 'src/core/attach.ts', 'src/core/focus.ts', 'src/host/joint.ts'],
+  outdir: dir, outbase: 'src', bundle: true, platform: 'node', format: 'esm', outExtension: { '.js': '.mjs' }, loader: { '.txt': 'text' }, logLevel: 'silent',
+});
+const mod = (n) => import(pathToFileURL(join(dir, `${n}.mjs`)));
+const AS = await mod('core/asset');
+const AT = await mod('core/attach');
+const F = await mod('core/focus');
+const J = await mod('host/joint');
+
+const calls = [];
+let reply = () => '';
+globalThis.risuai = { runLLMModel: async (o) => (calls.push(o), { type: 'success', result: reply(o, calls.length) }) };
+
+test('asset: 맨 앞 <Thoughts> 칸은 번호에서 빠지고 저장 본문 앞에 그대로 남는다', () => {
+  const think = '<Thoughts>\nAileen [▣| should smile\n\nmore\n</Thoughts>\n\n';
+  const s = AS.splitNarrative(`${think}첫 단락\n\n둘째 단락\n[▣|상태]`);
+  assert.equal(s.leading, think);
+  assert.equal(s.narrative, '첫 단락\n\n둘째 단락');
+  assert.equal(s.trailing, '[▣|상태]');
+  const plain = AS.splitNarrative('<thoughts>x</thoughts>본문');
+  assert.equal(plain.leading, '');
+  assert.equal(plain.narrative, '본문');
+  const job = { original: '', paras: ['첫 단락', '둘째 단락'], leading: think, trailing: '[▣|상태]', messages: [] };
+  const d = { characters: ['Aileen'], aliases: new Map([['aileen', 'Aileen']]), keywords: ['smile'], keywordSet: new Set(['smile']) };
+  const out = AS.finishAsset(job, '[{"line": 1, "tag": "<img=Aileen_smile>"}]', d, 2);
+  assert.equal(out, `${think}첫 단락\n\n<img=Aileen_smile>\n\n둘째 단락\n[▣|상태]`);
+});
+
+test('attach: 묶음 준비는 번호를 이어 가고 system 은 그대로, 단건은 예전과 같다', () => {
+  const sys = { role: 'system', content: 'Example [[ATTACH:photo]]what the picture shows[[/ATTACH]]' };
+  const a = [sys, { role: 'user', content: '[[ATTACH:photo]]문[[/ATTACH]]' }];
+  const b = [sys, { role: 'user', content: '[[ATTACH:gift]]꽃[[/ATTACH]] [[ATTACH:photo]]문[[/ATTACH]]' }];
+  const r = AT.prepareAttachmentGroups([a, b]);
+  assert.equal(r.groups[0][0], sys);
+  assert.equal(r.groups[1][0], sys);
+  assert.equal(r.groups[0][1].content, '[ATTACHMENT A1]');
+  assert.equal(r.groups[1][1].content, '[ATTACHMENT A2] [ATTACHMENT A1]');
+  assert.ok(r.data.content.includes('A2 {"kind":"gift","content":"꽃"}'));
+  const one = AT.prepareAttachments(a);
+  assert.equal(one.length, 3);
+  assert.equal(one[1].content, '[ATTACHMENT A1]');
+  const marked = AT.markPrepared([{ role: 'user', content: '[[ATTACH:photo]]x[[/ATTACH]]' }]);
+  assert.equal(AT.prepareAttachments(marked), marked);
+});
+
+test('joint: 통합 요청에서도 각 작업의 system 예시는 바뀌지 않고 자료는 하나만 붙는다', async () => {
+  calls.length = 0;
+  reply = () => '{"gnet": {"a": 1}, "phone": {"b": 2}}';
+  const sys = { role: 'system', content: 'Example [[ATTACH:photo]]what the picture shows[[/ATTACH]]' };
+  const j = new J.Joint('aux');
+  await Promise.all([j.ask('gn', [sys, { role: 'user', content: '[[ATTACH:photo]]골목[[/ATTACH]]' }]), j.ask('phone', [sys, { role: 'user', content: 'p' }])]);
+  assert.equal(calls.length, 1);
+  const msgs = calls[0].messages;
+  assert.equal(msgs.length, 3);
+  const body = JSON.parse(msgs[1].content);
+  const texts = JSON.stringify(body);
+  assert.ok(texts.includes('what the picture shows[[/ATTACH]]'), 'system 예시 그대로');
+  assert.ok(texts.includes('[ATTACHMENT A1]'));
+  assert.ok(msgs[2].content.includes('A1 {"kind":"photo","content":"골목"}'));
+  assert.ok(!msgs[2].content.includes('what the picture shows'));
+});
+
+test('focus: cost·room 을 주면 건별 합으로 고르고 결과는 예전과 같은 규칙', () => {
+  const items = [1, 2, 3, 4, 5, 6].map((n) => ({ order: n, related: n % 2 === 0, free: n === 1, data: `r${n}` }));
+  let fitsCalls = 0;
+  const fits = (kept) => (fitsCalls++, kept.join(',').length <= 100);
+  const old = F.pickRecords(items, { focus: true, recent: 2, max: 3, fits });
+  fitsCalls = 0;
+  const fast = F.pickRecords(items, { focus: true, recent: 2, max: 3, fits, cost: (d) => d.length + 1, room: 100 });
+  assert.deepEqual(fast, old);
+  assert.ok(fitsCalls <= 1);
+  // 큰 기록은 건너뛰고 뒤의 작은 기록을 넣는다
+  const big = [{ order: 3, related: true, data: 'x'.repeat(50) }, { order: 2, related: true, data: 'y' }, { order: 1, related: true, data: 'z' }];
+  assert.deepEqual(F.pickRecords(big, { focus: false, recent: 0, max: 5, fits: () => true, cost: (d) => d.length, room: 10 }), ['z', 'y']);
+  // 합이 맞아도 실제 확인에서 넘치면 나중에 넣은 것부터 뺀다
+  assert.deepEqual(F.pickRecords(big.slice(1), { focus: false, recent: 0, max: 5, fits: (k) => k.length < 2, cost: () => 1, room: 10 }), ['y']);
+});
+
+test('splitCombined partial: 잘린 칸·모르는 칸은 빼고 다 읽은 칸은 살린다, 말버릇 칸은 phone 끝에', () => {
+  const keys = ['gnet', 'gal', 'phone'];
+  assert.throws(() => J.splitCombined('{"gnet": {"a": 1}, "gal": {"b": 2}, "phone": {"c": ', keys), /통합 응답/);
+  assert.deepEqual(J.splitCombined('{"gnet": {"a": 1}, "gal": {"b": 2}, "phone": {"c": ', keys, true), { gnet: '{"a": 1}', gal: '{"b": 2}' });
+  assert.deepEqual(J.splitCombined('{"x": [1, {"y": "}"}], "gnet": "str", "gal": null, "phone": {"c": 3}}', keys, true), { gal: null, phone: '{"c": 3}' });
+  assert.deepEqual(J.splitCombined('Sorry, I cannot.', keys, true), {});
+  const h = J.splitCombined('{"gnet": null, "phone": {"u": 1}}\n<ph-habits>[{"id":"a"}]</ph-habits>');
+  assert.equal(h.phone, '{"u": 1}<ph-habits>[{"id":"a"}]</ph-habits>');
+  assert.equal(h.gnet, null);
+});
+
+test('joint: 한 칸만 잘리면 그 작업만 따로, 둘 이상 잘리면 그것들만 한 번 더 묶는다', async () => {
+  calls.length = 0;
+  reply = (o, n) => (n === 1 ? '{"gnet": {"a": 1}, "gal": {"b": 2}, "wpf": {"c": 3}, "sm": {"d": 4}, "phone": {"e":' : '{"only": 1}');
+  const j = new J.Joint('aux', undefined, ['phone', 'gn', 'gal', 'wpf', 'sm']);
+  const out = await Promise.all(['gn', 'gal', 'wpf', 'sm', 'phone'].map((k) => j.ask(k, [{ role: 'user', content: k }])));
+  assert.equal(calls.length, 2);
+  assert.deepEqual(out, ['{"a": 1}', '{"b": 2}', '{"c": 3}', '{"d": 4}', '{"only": 1}']);
+  assert.equal(calls[1].messages[0].content, 'phone');
+
+  calls.length = 0;
+  reply = (o, n) => (n === 1 ? '{"gnet": {"a": 1}, "gal": {"b": 2}, "wpf": {"c": 3}, "sm":' : '{"sm": {"d": 4}, "phone": {"e": 5}}');
+  const k = new J.Joint('aux', undefined, ['phone', 'gn', 'gal', 'wpf', 'sm']);
+  const out2 = await Promise.all(['gn', 'gal', 'wpf', 'sm', 'phone'].map((x) => k.ask(x, [{ role: 'user', content: x }])));
+  assert.equal(calls.length, 2);
+  assert.deepEqual(out2, ['{"a": 1}', '{"b": 2}', '{"c": 3}', '{"d": 4}', '{"e": 5}']);
+  assert.ok(calls[1].messages[0].content.includes('"sm", "phone"'));
+});
