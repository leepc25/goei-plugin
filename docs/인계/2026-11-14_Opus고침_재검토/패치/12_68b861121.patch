index 0000000000..fab653ffa0
--- /dev/null
+++ b/tests/fix3-people.test.mjs
@@ -0,0 +1,139 @@
+// 전수검사 11-13 인물 기록 고침 3: 단계 글·꼬리 글이 지침 「Main」 절로 (기본 글은 옛 글과 같다), 말투만 고친 호칭 변경, 성적 정책 글 한 번, 갱신기 본문 정리·계기 이름
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { build } from 'esbuild';
+import { mkdir } from 'node:fs/promises';
+import { join } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+const dir = '/tmp/audit_1113/fix3/people';
+await mkdir(dir, { recursive: true });
+const outfile = join(dir, `bundle-${process.pid}.mjs`);
+const ENTRY = `
+export * as T from './src/core/people/types';
+export * as S from './src/core/people/store';
+export * as Inj from './src/core/people/inject';
+export * as R from './src/core/people/request';
+export * as Fac from './src/core/people/faction';
+export * as Rh from './src/core/people/rhythm';
+export * as Ax from './src/core/people/axes';
+export * as Aff from './src/core/people/affinity';
+export * as Sx from './src/core/people/sexual';
+export * as U from './src/core/people/updater';
+export * as St from './src/core/people/settings';
+export * as G from './src/core/guides';
+`;
+await build({ stdin: { contents: ENTRY, resolveDir: process.cwd(), loader: 'ts' }, bundle: true, format: 'esm', platform: 'node', target: 'es2022', charset: 'utf8', loader: { '.txt': 'text', '.css': 'text' }, outfile, logLevel: 'silent' });
+const { T, S, Inj, R, Fac, Rh, Ax, Aff, Sx, U, St, G } = await import(pathToFileURL(outfile));
+
+const NEW = /^(PEOPLE\.(EXPRESS_\d|TASTE_NOTE|OPENNESS_NOTE|AFFINITY\.\d|TASTE\.-?\d|OPENNESS\.\d|AXIS\.[A-Za-z]+\.\d)|RHYTHM\.(HEAD|CLOCK_HEAD|METHOD)|FACTION\.(HEAD|STAGE\.[a-z]+)|STATUS\.RECENT_(CASH|POINT))$/;
+const cutNew = (src) => src.replace(/@@SECTION ([^\n]+)\n[\s\S]*?\n@@END\n?\n?/g, (all, n) => (NEW.test(n.trim()) ? '' : all));
+const withEdit = (src, name, f) => src.replace(new RegExp(`(@@SECTION ${name.replace(/[.]/g, '\\.')}\\n)([\\s\\S]*?)(\\n@@END)`), (a, h, b, e) => h + f(b) + e);
+const chat = (...msgs) => ({ message: msgs.map(([role, data, chatId]) => ({ role, data, chatId })) });
+const person = (name, extra = {}) => ({ name, faction: 'A00', seeded: { from: 'none', at: '' }, slots: {}, affinity: { base: 0 }, address: { toUser: '요원', register: '반말' }, express: 1, aliases: [], axes: T.DEFAULT_AXES(), axesFrom: 'default', patterns: [], candidates: {}, ...extra });
+
+const render = () => {
+  const c = chat(['user', '출근', 'u1'], ['char', '쟈알디가 말했다.', 'c1']);
+  const store = T.emptyStore();
+  const p = person('쟈알디');
+  store.people.쟈알디 = p;
+  const live = S.liveness(c);
+  const out = [];
+  [-80, -40, -5, 0, 100, 150, 200, 280].forEach((base, i) => {
+    p.affinity.base = base;
+    const ch = [
+      { id: 't', anchor: 'c1', seq: 0, src: 'story', who: '쟈알디', kind: 'taste', band: Math.min(3, i - 3) },
+      { id: 'o', anchor: 'c1', seq: 1, src: 'story', who: '쟈알디', kind: 'openness', init: [0, 90, 150, 210, 270][i % 5] },
+    ];
+    out.push(Inj.personBlock(p, store, live, ch, { mode: 'record', user: '김솔음', taste: true, openness: true, axes: true }));
+  });
+  out.push(Ax.axesLinesEn({ relationalInitiative: 10, expressionDirectness: 30, emotionalExpressiveness: 50, guardedness: 70, impulsivity: 90, relationshipPersistence: 100 }).join('\n'));
+  const fl = ['friendly', 'favorable', 'neutral', 'wary', 'hostile'].map((id, i) => ({ code: `X${i}`, name: `세력${i}`, value: 0, stage: T.FACTION_STAGES[id], base: 0 }));
+  out.push(Fac.factionsBlock(fl, '김솔음'), Fac.factionsBlock(fl));
+  out.push(Rh.rhythmClockLines({ turn: 3, hooks: [], active: { short: 0, mid: 0, long: 0 }, lastPlant: null, plantAllowed: true, plantBlocked: '', priority: [], lastMethod: 'sound' }).join('\n'));
+  out.push(Inj.rhythmBlock([{ key: 'hook:a', text: 'x' }], null, ['clock']));
+  return out.join('\n=====\n');
+};
+
+test('새 절이 있어도 없어도 요청 글이 같다 (기본 글 = 옛 코드 글)', () => {
+  G.setGuideOverride('Main', '');
+  const base = render();
+  assert.match(base, /Relationship → 김솔음: 극도의 적대 \(Extreme hostility\. Keep the actual cause/);
+  assert.match(base, /## Factions → 김솔음 \(standing of each organization toward 김솔음, kept by the system; members act accordingly\)/);
+  assert.match(base, /Members welcome 김솔음, share information freely and take 김솔음's side/);
+  assert.match(base, /Previous staging method: sound — do not use the same anticipation method in consecutive turns\./);
+  const cut = cutNew(G.guideDefault('Main'));
+  assert.ok(!cut.includes('PEOPLE.AFFINITY.0') && cut.includes('PEOPLE.RULE') && cut.includes('SEXUAL.POLICY'));
+  G.setGuideOverride('Main', cut);
+  try {
+    assert.equal(G.guideSec('Main', 'FACTION.HEAD'), null);
+    assert.equal(render(), base);
+  } finally { G.setGuideOverride('Main', ''); }
+});
+
+test('절을 고치면 그 글이 바뀐다', () => {
+  const MARK = 'ZZ-EDIT';
+  for (const name of ['PEOPLE.AFFINITY.0', 'PEOPLE.AFFINITY.7', 'PEOPLE.TASTE.-3', 'PEOPLE.TASTE.3', 'PEOPLE.OPENNESS.0', 'PEOPLE.OPENNESS.4', 'PEOPLE.AXIS.guardedness.3', 'FACTION.HEAD', 'FACTION.STAGE.hostile', 'RHYTHM.METHOD']) {
+    G.setGuideOverride('Main', withEdit(G.guideDefault('Main'), name, (b) => `${b} ${MARK}`));
+    try { assert.ok(render().includes(MARK), name); } finally { G.setGuideOverride('Main', ''); }
+  }
+});
+
+test('호칭: 호칭 없이 말투만 고친 변경도 말투에 반영된다', () => {
+  const p = person('새인물', { address: { toUser: '', register: '존댓말' } });
+  const reg = [{ id: 'a1', anchor: 'c1', seq: 0, src: 'manual', who: '새인물', kind: 'address', toUser: '', register: '반말' }];
+  assert.deepEqual(Aff.addressOf(p, reg), { toUser: '', register: '반말' });
+  const both = [{ id: 'a0', anchor: 'c0', seq: 0, src: 'story', who: '새인물', kind: 'address', toUser: '선배', register: '존댓말' }, ...reg];
+  assert.deepEqual(Aff.addressOf(p, both), { toUser: '선배', register: '반말' });
+  p.address.pin = true;
+  assert.deepEqual(Aff.addressOf(p, both), { toUser: '', register: '존댓말' }, '고정은 그대로');
+});
+
+test('성적 프로필 정책 글은 여러 인물 블록에서 한 번만', () => {
+  const s = St.peopleSettings({ $pp_axes: '1', $pp_sexual_desire: '1' });
+  assert.ok(s.sexualDesire && s.features.has('axes'));
+  const store = T.emptyStore();
+  for (const n of ['쟈알디', '도경']) {
+    const p = person(n);
+    Sx.setSexualText(p, 'desire', `${n} 취향`, 'c1', true);
+    store.people[n] = p;
+  }
+  const c = chat(['user', '쟈알디와 도경을 만난다', 'u1'], ['char', '쟈알디와 도경이 왔다.', 'c1'], ['user', '인사', 'u2']);
+  const r = R.peopleBlockFor(c, { settings: s, store, sheetOf: () => null, user: '김솔음' });
+  assert.deepEqual(r.people.sort(), ['도경', '쟈알디']);
+  assert.equal(r.text.split('Sexual profile (policy: sexual_context_only').length - 1, 2);
+  assert.equal(r.text.split(Sx.sexualDirectorPolicy()).length - 1, 1, '정책 긴 글은 한 번');
+  // 한 인물 블록(기본)은 그대로 긴 글을 붙인다
+  const one = Inj.personBlock(store.people.쟈알디, store, S.liveness(c), [], { sexual: Sx.sexualTexts(store.people.쟈알디, s) });
+  assert.ok(one.includes(`Sexual profile (policy: sexual_context_only — ${Sx.sexualDirectorPolicy()})`));
+});
+
+test('갱신기 본문: 생각·주석·그림 태그·상점 표식을 뺀다', () => {
+  const t = U.cleanSpan('<Thoughts>비밀</Thoughts>\n쟈알디가 왔다.\n<img="쟈알디_neutral">\n<!-- note -->\n그는 웃었다. <think>x</think> [shop: 칼집|주인]', 10000);
+  assert.ok(!/비밀|<img|note|<think>|shop/.test(t), t);
+  assert.match(t, /쟈알디가 왔다\.[\s\S]*그는 웃었다\./);
+});
+
+test('갱신기 자료: 호감이 글로만이어도 세력 평판 수치가 켜져 있으면 계기 이름을 준다', () => {
+  const store = T.emptyStore();
+  store.people.쟈알디 = person('쟈알디');
+  const c = chat(['user', '출근', 'u1'], ['char', '쟈알디가 왔다.', 'c1']);
+  const names = [{ name: '쟈알디', aliases: [], titles: [] }];
+  const cuesOf = (st) => U.buildUpdate(c, store, [1], { settings: St.peopleSettings(st), system: 'SYS', values: {}, names }).data.cues;
+  assert.deepEqual([...cuesOf({ $pp_num_affinity: '0' })], [...T.CUES]);
+  assert.deepEqual([...cuesOf({ $pp_affinity: '0' })], [...T.CUES]);
+  assert.deepEqual(cuesOf({ $pp_num_affinity: '0', $pp_num_faction_rep: '0' }), []);
+  assert.deepEqual(cuesOf({ $pp_num_affinity: '0', $pp_faction_rep: '0' }), []);
+  assert.deepEqual([...cuesOf({})], [...T.CUES]);
+});
+
+test('성적 문체: 고친 글이 이미 「When false」로 시작하면 두 번 붙이지 않는다', () => {
+  const s = St.peopleSettings({ $pp_axes: '1', $pp_sexual_desire: '1', $pp_explicit_style: '0' });
+  const def = Sx.sexualWriterSection(s);
+  assert.ok(def.includes('When false, use the 0.10.7 style') && def.includes('When true, write like adults'));
+  G.setGuideOverride('UpdaterExtra', withEdit(G.guideDefault('UpdaterExtra'), 'SEXUAL.PLAIN_STYLE', () => 'When false, keep it blunt.'));
+  try {
+    const out = Sx.sexualWriterSection(s);
+    assert.ok(out.includes('When false, keep it blunt.') && !out.includes('When false: When false'));
+  } finally { G.setGuideOverride('UpdaterExtra', ''); }
+});
diff --git a/tests/fix3-pipe.test.mjs b/tests/fix3-pipe.test.mjs
new file mode 100644
index 0000000000..14eb760ed8
--- /dev/null
+++ b/tests/fix3-pipe.test.mjs
@@ -0,0 +1,92 @@
+// 전수검사 11-13 (3차): 토크나이저 기억 상한, 묶음 요청의 동시 요청 수, 가짜 관리국 신분 읽기, 진행 창 토큰 채우기, body.ts 연결
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { build } from 'esbuild';
+import { mkdir, readFile } from 'node:fs/promises';
+import { createRequire } from 'node:module';
+import { join } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+const require = createRequire(import.meta.url);
+const dir = '/tmp/audit_1113/fix3/pipe';
+await mkdir(dir, { recursive: true });
+const outfile = join(dir, `bundle-${process.pid}.mjs`);
+const ENTRY = `
+export * as Tok from './src/core/tokenizer';
+export * as Prog from './src/core/progress';
+export * as J from './src/host/joint';
+export * as P from './src/host/people';
+`;
+await build({ stdin: { contents: ENTRY, resolveDir: process.cwd(), loader: 'ts' }, bundle: true, format: 'esm', platform: 'node', target: 'es2022', charset: 'utf8', loader: { '.txt': 'text', '.css': 'text' }, outfile, logLevel: 'silent' });
+const { Tok, Prog, J, P } = await import(pathToFileURL(outfile));
+const body = await readFile(new URL('../src/body.ts', import.meta.url), 'utf8');
+
+test('토크나이저: 긴 글을 많이 세도 수는 그대로 (글자 수 상한으로 밀려난 뒤 다시 세도 같다)', () => {
+  const ranks = require('js-tiktoken/ranks/o200k_base');
+  const { Tiktoken } = require('js-tiktoken/lite');
+  assert.equal(Tok.setTokenizerRanks({ pat_str: ranks.pat_str, special_tokens: ranks.special_tokens, bpe_ranks: ranks.bpe_ranks }, 'o200k_base'), true);
+  const ref = new Tiktoken(ranks);
+  const big = (i) => `${i} `.padEnd(400_000, 'ab ');
+  const first = Tok.exactTokens(big(0));
+  assert.equal(first, ref.encode(big(0), [], []).length);
+  for (let i = 1; i <= 11; i++) Tok.exactTokens(big(i)); // 400만 자 넘김 → 앞 글이 밀려난다
+  assert.equal(Tok.exactTokens(big(0)), first);
+  assert.equal(Tok.exactTokens('안녕하세요'), ref.encode('안녕하세요', [], []).length);
+  Tok.clearTokenizer();
+});
+
+test('Joint: 동시 요청 수 1이면 통합 뒤 혼자 보내는 요청도 한 번에 하나 (pipeline#5)', async () => {
+  let live = 0;
+  let peak = 0;
+  globalThis.risuai = {
+    runLLMModel: async () => {
+      live++;
+      peak = Math.max(peak, live);
+      await new Promise((r) => setTimeout(r, 20));
+      live--;
+      return { type: 'success', result: '{"gnet": {"a": 1}, "phone": {"b": 2}}' };
+    },
+  };
+  const run = async (concurrent) => {
+    peak = 0;
+    const j = new J.Joint('aux', undefined, ['gn', 'phone'], concurrent);
+    await Promise.all([j.ask('gn', [{ role: 'user', content: 'g' }]), j.ask('phone', [{ role: 'user', content: 'p' }])]);
+    // 이미 보낸 묶음에 다시 묻기 → 각자 따로
+    await Promise.all([j.ask('gn', [{ role: 'user', content: 'g2' }]), j.ask('phone', [{ role: 'user', content: 'p2' }])]);
+    return peak;
+  };
+  assert.equal(await run(1), 1);
+  assert.equal(await run(undefined), 2, '설정 0(제한 없음)은 그대로 동시에');
+  delete globalThis.risuai;
+});
+
+test('statusIdentity: 가짜 관리국(B00) 채팅의 「관리국/사원」은 B00 으로 읽는다 (gmain#2)', () => {
+  const line = (id) => `글\n[▣|2025.01.01|02:47 AM|☀️|4°C|서울 종로구 거리|없음|없음|없음|${id}|1000]`;
+  const chat = (id, faction) => ({ message: [{ role: 'user', data: '출근' }, { role: 'char', data: line(id), chatId: 'c1' }], scriptstate: faction ? { '$st_faction': faction } : {} });
+  const b = P.statusIdentity(chat('관리국/사원', 'B00'));
+  assert.equal(b?.faction, 'B00');
+  assert.equal(b?.level, 1);
+  assert.equal(P.statusIdentity(chat('관리국/사원', 'A00'))?.faction, 'A00');
+  assert.equal(P.statusIdentity(chat('관리국/요원', ''))?.faction, 'A00', '소속을 모르면 그대로');
+  assert.equal(P.statusIdentity(chat('가짜 관리국/대리', 'B00'))?.faction, 'B00');
+});
+
+test('진행 창: 보낸 뒤 센 토큰을 호출 줄·본편에 채운다 (perf#7)', () => {
+  Prog.resetProgress();
+  const t = Prog.progressBegin();
+  const id = Prog.progressCallStart('갱신기', 'aux', 0);
+  Prog.progressCallTokens(id, 123);
+  assert.equal(Prog.progressTurn().calls.find((c) => c.id === id).reqTokens, 123);
+  Prog.progressMainTokens(77, t);
+  assert.equal(Prog.progressTurn().mainTokens, 77);
+  Prog.progressMainTokens(88, { other: true });
+  assert.equal(Prog.progressTurn().mainTokens, 77, '다른 턴이면 건드리지 않는다');
+  Prog.resetProgress();
+});
+
+test('body.ts 연결: 이미지 지침 {{user}} 풀기, 인물 갱신 채팅 번호, 묶음 동시 요청 수, 캐릭터 바뀌면 에셋 다시 읽기', () => {
+  assert.match(body, /appendImgPrompt\(out, evaluate\(buildImgPrompt\(cfg, names, s\.assetPlayer\), \{ vars: chat\.scriptstate \?\? \{\}, char: char\.name, user: me\?\.name \|\| userOrTag\(\) \}\)\)/);
+  assert.match(body, /requestPeopleUpdate\('turn', \{ at: \{ charIndex: arg\.characterIndex, chatIndex: arg\.chatIndex \} \}\)/);
+  assert.match(body, /new Joint\(group\[0\]\.model, group\[0\]\.fixed, group\.map\(\(t\) => t\.kind\), genSettings\(now!\.scriptstate\)\.concurrent\)/);
+  assert.match(body, /snap\.charIndex !== lastChar \|\| \(next\.changed && next\.fabVisible\)\)\) void loadModuleAssets\(\)/);
+});
diff --git a/tests/fix3-shop.test.mjs b/tests/fix3-shop.test.mjs
new file mode 100644
index 0000000000..720d2b6b6e
--- /dev/null
+++ b/tests/fix3-shop.test.mjs
@@ -0,0 +1,89 @@
+// 전수검사 11-13 · 상점 고침 점검: 다시 굴리면 산 것·판 것 되살림(shop#4), 같은 가게에 머물 때 지난 턴 사건 되풀이 없음(shop#2·mainreach#1),
+// 원이 아닌 대가(gshop#1), 거래 끊기 끔이면 <closed/> 꼴 줄 없음(gshop#13), 머리말 지시를 지침 절로(wording#4)
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { build } from 'esbuild';
+import { mkdir } from 'node:fs/promises';
+import { join, resolve } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+const dir = '/tmp/audit_1113/fix3/shop';
+await mkdir(dir, { recursive: true });
+await build({
+  stdin: { contents: "export * from './shop'; export { setGuideOverride, guideDefault } from './guides';", resolveDir: resolve('src/core'), loader: 'ts' },
+  outfile: join(dir, 'shop.mjs'), bundle: true, platform: 'node', format: 'esm', loader: { '.txt': 'text' }, logLevel: 'silent',
+});
+const S = await import(pathToFileURL(join(dir, 'shop.mjs')));
+
+const SHELF = '<shop-identity>\nsells: 공구\nnever: 음식\nprices: 싸다\nprice_range: 1000~50000\n</shop-identity>\n<owner>뭐 찾소.</owner>\n<shelf>\n손전등|18000|사용|flashlight|0.5|LED|비춘다\n생수|1500|소모1|water bottle|0.5|500ml|\n</shelf>';
+const msgs = (last) => [{ role: 'user', data: '들어간다', chatId: 'u1' }, { role: 'char', data: last, chatId: 'c1' }];
+const src = (st) => ({ st, refs: '', story: '', status: '', situation: '', identity: '', language: null });
+
+/** R1(상점 표식)에서 손전등을 사고 칼을 판 상태 */
+function visit() {
+  const c = { message: msgs('x\n[shop: 철물점|주인]'), scriptstate: {} };
+  let st = S.applyShelf(S.readShop(S.settleShop(c, 1).vars), S.parseShelf(SHELF, null), S.shopSettings({}));
+  const lamp = st.items.find((x) => x.name === '손전등');
+  st = S.markSold(st, lamp.id, st.key);
+  st = S.startSell(st, { itemId: 'i_9', name: '낡은 칼', desc: '', use: false, effect: '' });
+  st = S.applyTalk(st, S.parseTalk('<owner>오천.</owner>\n<change mode="none"></change>\n<offer>5000</offer>'));
+  st = S.closeSale(st, st.key);
+  return { c: { ...c, scriptstate: S.shopVars(st) }, st };
+}
+
+test('shop#4: 산·판 응답을 다시 굴리면 진열대·판 것이 되살아난다', () => {
+  const { c, st } = visit();
+  assert.equal(st.sales[0].k, st.key);
+  assert.equal(S.currentShop(c).items.find((x) => x.name === '손전등').sold, true);
+  // R1 을 다시 굴림 → 같은 가게 표식의 새 응답 R1'
+  const re = { message: [c.message[0], { role: 'char', data: 'y\n[shop: 철물점|주인]', chatId: 'c1b' }], scriptstate: c.scriptstate };
+  const next = S.readShop(S.settleShop(re, 1).vars);
+  assert.notEqual(next.key, st.key);
+  assert.equal(next.items.find((x) => x.name === '손전등').sold, undefined);
+  assert.deepEqual(next.sales, []);
+  assert.deepEqual(S.shopEvents({ ...re, scriptstate: S.shopVars(next) }), []);
+  // 키 없는 산 것(옛 저장분)은 그대로 산 것
+  const old = { ...st, items: st.items.map((x) => (x.name === '생수' ? { ...x, sold: true } : x)) };
+  assert.equal(S.reviveShop(old, new Set()).items.find((x) => x.name === '생수').sold, true);
+});
+
+test('shop#2·mainreach#1: 같은 가게에 머물러도 지난 턴의 판 것·대화는 다시 안 간다', () => {
+  const { c } = visit();
+  const st1 = S.readShop(c.scriptstate);
+  const talked = S.applyTalk(S.sayToOwner(st1, '깎아 줘'), S.parseTalk('<owner>안 돼.</owner>\n<change mode="none"></change>'));
+  const c1 = { ...c, scriptstate: S.shopVars(talked) };
+  assert.equal(S.shopEvents(c1).length, 2);
+  const c2m = [...c1.message, { role: 'user', data: '둘러본다', chatId: 'u2' }, { role: 'char', data: 'z\n[shop: 철물점|주인]', chatId: 'c2' }];
+  const r = S.settleShop({ ...c1, message: c2m }, 3);
+  assert.deepEqual(S.shopEvents({ message: c2m, scriptstate: { ...c1.scriptstate, ...r.vars } }), []);
+});
+
+test('gshop#1: 원이 아닌 대가는 주인 대화 요청에 그 말로 간다', () => {
+  const st = { ...S.emptyShop({ raw: '', shop: '기억 가게', owner: '' }, 'k'), loaded: true, items: [{ id: 'a', name: '기억의 병', price: 0, pay: '기억 한 조각', use: true, desc: 'd', effect: 'e' }, { id: 'b', name: '혼합', price: 5000, pay: '피 한 방울', use: true, desc: 'd', effect: 'e' }] };
+  const user = S.talkPrompt(src(st), S.shopSettings({})).at(-1).content;
+  assert.match(user, /기억의 병\|기억 한 조각\|/);
+  assert.match(user, /혼합\|피 한 방울 \+ 5000\|/);
+});
+
+test('gshop#13: 거래 끊기가 꺼져 있으면 출력 꼴에 <closed/> 줄이 없다', () => {
+  const st = { ...S.emptyShop({ raw: '', shop: '가게', owner: '' }, 'k'), loaded: true };
+  const sys = (kick) => S.talkPrompt(src(st), { ...S.shopSettings({}), kick }).map((m) => m.content).join('\n');
+  assert.match(sys(true), /<closed\/> only if the owner ends the dealing\./);
+  assert.doesNotMatch(sys(false), /<closed\/> only if the owner ends the dealing\./);
+});
+
+test('wording#4: 머리말 지시는 지침 절에서, 기본 글은 옛 글 그대로', () => {
+  const st = { ...S.emptyShop({ raw: '', shop: '가게', owner: '' }, 'k'), loaded: true, notes: [{ id: 'n', title: '쪽지', price: 1, text: 't' }] };
+  const s = { ...src(st), refs: 'R', assign: 'A', orders: 'O' };
+  const user = () => S.talkPrompt(s, S.shopSettings({}), 'Cos').at(-1).content;
+  const u = user();
+  for (const h of ['[참고 자료 — 작중 인물에게 자동 공개되지 않음]\nR', '[이번 진열 배정 — 칸마다 그대로 따를 것]\nA', '[진행 중 맞춤 주문 — 이미 선납됨, 다시 견적 내지 말 것]\nO', '[이번 방문에 내민 정보 쪽지 — 다시 내밀지 말 것]\n']) assert.ok(u.includes(h), h);
+  S.setGuideOverride('Cos', S.guideDefault('Cos').replace('[참고 자료 — 작중 인물에게 자동 공개되지 않음]', '[자료 고침]'));
+  assert.ok(user().includes('[자료 고침]\nR'));
+  // 절이 없으면 옛 글
+  S.setGuideOverride('Cos', S.guideDefault('Cos').replace(/\n*@@SECTION HEAD_REFS\n[\s\S]*?\n@@END/, ''));
+  assert.ok(user().includes('[참고 자료 — 작중 인물에게 자동 공개되지 않음]\nR'));
+  S.setGuideOverride('Cos', null);
+  // 홈쇼핑 머리말은 그대로
+  assert.ok(S.broadcastMaterial(s, S.shopSettings({})).includes('[참고 자료 — 작중 인물에게 자동 공개되지 않음]\nR'));
+});
diff --git a/tests/fix3-text.test.mjs b/tests/fix3-text.test.mjs
new file mode 100644
index 0000000000..aac9517fdb
--- /dev/null
+++ b/tests/fix3-text.test.mjs
@@ -0,0 +1,125 @@
+// 전수검사 11-13 고침 3: 괴담톡 절 고르기·보기 방 확인, 쇼핑몰·연어 마켓 지침, 로어 표식 떼기, 위키 표·링크·본편 문서·그림
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { build } from 'esbuild';
+import { existsSync, readFileSync } from 'node:fs';
+import { mkdir } from 'node:fs/promises';
+import { join } from 'node:path';
+import { pathToFileURL } from 'node:url';
+import { REAL } from './realcard.mjs';
+import { initTestData } from './data-init.mjs';
+
+const dir = '/tmp/audit_1113/fix3/text';
+await mkdir(dir, { recursive: true });
+const file = join(dir, 'core.mjs');
+const define = Object.fromEntries(['__UPDATE_BASE__', '__PLUGIN_VERSION__', '__WORLD_PACK__', '__INSTALL_PACK__', '__ITEMS_PACK__', '__LOOKS_PACK__', '__HOMESHOP_PACK__'].map((k) => [k, '"{}"']));
+await build({ entryPoints: ['src/core/index.ts'], outfile: file, bundle: true, platform: 'node', format: 'esm', target: 'es2022', charset: 'utf8', loader: { '.txt': 'text' }, define, logLevel: 'silent' });
+const C = await import(pathToFileURL(file));
+initTestData(C);
+const G = await import(pathToFileURL(await (async () => {
+  const f = join(dir, 'guides.mjs');
+  await build({ entryPoints: ['src/core/guides.ts'], outfile: f, bundle: true, platform: 'node', format: 'esm', charset: 'utf8', loader: { '.txt': 'text' }, logLevel: 'silent' });
+  return f;
+})()));
+
+const realLore = existsSync(REAL) ? (() => { const m = JSON.parse(readFileSync(REAL, 'utf8')); return m.lorebook ?? m.module?.lorebook; })() : null;
+const P = C.phone;
+const PP = C.phonePrompt;
+const chatOf = (vars = {}, message = []) => ({ message, scriptstate: { '$st_faction': 'A00', ...vars } });
+const dmRoom = (cid, extra = {}) => ({ id: `dm_${cid}`, kind: 'dm', members: [cid], people: { [cid]: { id: cid, name: '상대' } }, messages: [], draft: '', unread: 0, ...extra });
+
+test('괴담톡: 내가 보낸 말에 답할 때는 Direct rooms 절을 붙이지 않는다 (gphone#7)', { skip: !realLore }, () => {
+  const chat = chatOf({}, [{ role: 'user', data: '사무실' }, { role: 'char', data: '조용하다' }]);
+  const d = P.directory(realLore, chat);
+  const c = d.contacts[0];
+  const st = P.blankState();
+  const r = dmRoom(c.id, { people: { [c.id]: P.personOf(c) } });
+  st.rooms[r.id] = r;
+  P.push(st, r, 'me', '어디세요?', '');
+  r.pending = { status: 'error', action: { type: 'send' } };
+  const send = PP.replyPrompt({ char: { globalLore: realLore, desc: '' }, chat }, st, r, d, {}).messages[0].content;
+  assert.doesNotMatch(send, /### Direct rooms/);
+  assert.match(send, /send: reply to the owner's exact text/);
+  r.pending = { status: 'error', action: { type: 'refresh' } };
+  const refresh = PP.replyPrompt({ char: { globalLore: realLore, desc: '' }, chat }, st, r, d, {}).messages[0].content;
+  assert.match(refresh, /### Direct rooms/, '방 새로고침에는 그대로');
+});
+
+test('괴담톡: 말이 있는 방이 둘 이상일 때만 방 사이 기억 절 (gphone#8)', { skip: !realLore }, () => {
+  const chat = chatOf({}, [{ role: 'user', data: '사무실' }, { role: 'char', data: '조용하다' }]);
+  const d = P.directory(realLore, chat);
+  const src = { char: { globalLore: realLore, desc: '' }, chat };
+  const cross = /crossRoomMessages contains retained messages/;
+  const plan = (st) => PP.refreshPrompt(src, st, d, {}, () => 0).prompt;
+  const blank = plan(P.blankState());
+  assert.ok(JSON.parse(blank.messages[1].content).rooms.length > 1, '빈 후보 방은 여럿');
+  assert.doesNotMatch(blank.messages[0].content, cross, '말이 있는 방이 없으면 붙지 않는다');
+  const two = P.blankState();
+  for (const c of d.contacts.slice(0, 2)) {
+    const r = dmRoom(c.id, { people: { [c.id]: P.personOf(c) } });
+    two.rooms[r.id] = r;
+    P.push(two, r, c.id, '안녕', '');
+  }
+  assert.match(plan(two).messages[0].content, cross, '말이 있는 방이 둘이면 붙는다');
+});
+
+test('괴담톡 보기 방: 지침 속 낱말이 아니라 절이 있는지로 본다 (hardcode#12)', () => {
+  const src = readFileSync(new URL('../src/core/phonePrompt.ts', import.meta.url), 'utf8');
+  assert.match(src, /if \(p\['VIEW\.OUTPUT'\] === undefined\) throw new PhoneError/);
+  assert.doesNotMatch(src, /system\.includes\('OUTPUT CONTRACT'\)/);
+});
+
+test('우주 쇼핑몰만 흥정 문장이 없다 (gshop#6 = 사용자 승인 가-3)', () => {
+  const shop = G.guideDefault('Shop');
+  const cos = G.guideDefault('Cos');
+  const bm = G.guideDefault('Bm');
+  assert.match(shop, / Haggling: the owner may refuse/);
+  assert.doesNotMatch(cos, /Haggling:/);
+  assert.match(bm, /Haggling:/);
+});
+
+test('로어 원문 첫 줄의 @@dont_activate 는 떼고 보낸다 (ggnet#13)', () => {
