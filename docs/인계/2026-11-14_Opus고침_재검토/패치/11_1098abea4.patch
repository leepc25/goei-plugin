+// 전수검사 11-13 인물 쪽 고침: 정리의 버린 원본·null 목록·Director 열쇠·need+notes·가진 물건 또 얻음·변경 기록 줄이기
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { build } from 'esbuild';
+import { mkdir } from 'node:fs/promises';
+import { join } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+const dir = '/tmp/audit_1113/fix2/people2';
+await mkdir(dir, { recursive: true });
+await build({
+  entryPoints: ['src/core/people/consolidate.ts', 'src/core/people/store.ts', 'src/core/people/types.ts', 'src/core/people/settings.ts', 'src/core/people/updater.ts', 'src/core/people/director.ts', 'src/core/people/affinity.ts', 'src/core/people/sexual.ts', 'src/core/itemrules.ts'],
+  outdir: dir, outbase: 'src', bundle: true, platform: 'node', format: 'esm', outExtension: { '.js': '.mjs' }, logLevel: 'silent',
+});
+const mod = async (n) => import(pathToFileURL(join(dir, `core/${n}.mjs`)));
+const C = await mod('people/consolidate');
+const S = await mod('people/store');
+const T = await mod('people/types');
+const St = await mod('people/settings');
+const U = await mod('people/updater');
+const D = await mod('people/director');
+const A = await mod('people/affinity');
+const X = await mod('people/sexual');
+const R = await mod('itemrules');
+
+const person = (name) => ({ name, faction: 'A00', seeded: { from: 'none', at: '' }, slots: {}, affinity: { base: 0 }, address: { toUser: '요원', register: '반말' }, express: 1, aliases: [] });
+
+test('정리: 어느 from 에도 없는 원본은 접혀서 살아 있지 않다', () => {
+  const chat = { message: [{ role: 'user', data: 'a', chatId: 'u1' }, { role: 'char', data: '쟈알디가 왔다.', chatId: 'c1' }] };
+  const e = (id, text) => ({ id, text, src: 'story', anchor: 'c1', seq: 1, quote: '왔다' });
+  const store = T.emptyStore();
+  store.people.쟈알디 = person('쟈알디');
+  store.people.쟈알디.slots.state = [e('s1', 'a'), e('s2', 'b'), e('s3', 'c')];
+  const settings = St.peopleSettings({});
+  const input = C.buildConsolidate(store, chat, '쟈알디', settings);
+  const live = S.liveness(chat);
+  const rep = C.applyConsolidate(store, '쟈알디', input, { slots: { state: [{ text: 'merged', from: ['s1'] }] } }, live, settings);
+  assert.deepEqual([rep.slots, rep.before, rep.after], [1, 3, 1]);
+  const list = store.people.쟈알디.slots.state;
+  assert.deepEqual(S.liveEntries(list, live).map((x) => x.text), ['merged']);
+  const st = S.entryStates(list, live);
+  assert.deepEqual([st.get('s1'), st.get('s2'), st.get('s3')], ['replaced', 'folded', 'folded']);
+});
+
+test('갱신기 응답: 목록 키의 null 은 빈 목록, 글은 여전히 오류', () => {
+  const r = U.parseUpdate('{"entries":[{"who":"쟈알디"}],"cues":null,"items":null,"shop":null}');
+  assert.equal(r.cues, undefined);
+  assert.equal(r.entries.length, 1);
+  assert.equal(r.shop, null, 'shop 의 null 은 그대로');
+  assert.throws(() => U.parseUpdate('{"cues":"없음"}'), /cues는 목록/);
+});
+
+test('Director: 빈 need·2차의 need 는 notes 가 있으면 notes 로', () => {
+  const notes = '"notes":[{"who":"쟈알디","now":"서류를 넘김"}]';
+  const a = D.parseDirectorAny(`{"need":[],${notes}}`, ['쟈알디'], true, true);
+  assert.equal(a.notes[0].now, '서류를 넘김');
+  const b = D.parseDirectorAny(`{"need":[{"kind":"chat","query":"x"}],${notes}}`, ['쟈알디'], true, false);
+  assert.equal(b.notes.length, 1);
+  const c = D.parseDirectorAny(`{"need":[{"kind":"nope","query":"x"}],${notes}}`, ['쟈알디'], true, true);
+  assert.equal(c.notes.length, 1);
+  assert.ok('need' in D.parseDirectorAny(`{"need":[{"kind":"chat","query":"x"}],${notes}}`, ['쟈알디'], true, true), '1차에서는 검색 요청 우선');
+  assert.throws(() => D.parseDirectorAny('{"need":[{"kind":"chat","query":"x"}]}', ['쟈알디'], true, false), /2차/);
+  assert.throws(() => D.parseDirectorAny('{"need":[{"kind":"nope","query":"x"}]}', ['쟈알디'], true, true), /비어/);
+});
+
+test('Director 재사용 열쇠: 입력이 같아도 최근 글이 달라지면 다른 열쇠', () => {
+  const s = St.peopleSettings({ $pp_director: 'scene', $pp_rhythm: '0' });
+  const store = T.emptyStore();
+  store.people.쟈알디 = person('쟈알디');
+  const m = (last) => ({ message: [{ role: 'user', data: '계속', chatId: 'u1' }, { role: 'char', data: last, chatId: 'c1' }, { role: 'user', data: '계속', chatId: 'u2' }] });
+  const k1 = D.buildDirector(m('쟈알디가 문을 열었다.'), store, ['쟈알디'], '계속', s, {}).key;
+  const k2 = D.buildDirector(m('쟈알디가 계단을 내려갔다.'), store, ['쟈알디'], '계속', s, {}).key;
+  const k3 = D.buildDirector(m('쟈알디가 문을 열었다.'), store, ['쟈알디'], '계속', s, {}).key;
+  assert.notEqual(k1, k2);
+  assert.equal(k1, k3);
+});
+
+test('소지품: 가진 물건을 new 로 또 얻으면 update 로 바꾸되 남은 횟수를 받은 수로 덮지 않는다', () => {
+  const c = { scriptstate: {}, message: [['user', 'x', 'u1'], ['char', '생수 두 병을 더 받았다. 보관해 둔 생수와 합쳤다.', 'c1']].map(([role, data, chatId]) => ({ role, data, chatId })) };
+  const store = T.emptyStore();
+  store.people.쟈알디 = person('쟈알디');
+  const s = St.peopleSettings({});
+  const input = U.buildUpdate(c, store, [1], { settings: s, system: 'S', values: {}, names: [{ name: '쟈알디', aliases: [], titles: [] }], items: [{ name: '생수', desc: '', use: true, left: 3, state: 'ok' }] });
+  const desc = '보관해 둔 생수';
+  const rep = U.applyUpdate(store, c, input, { items: [{ name: '생수', action: 'new', uses: 2, desc, m: 'm2', quote: '생수 두 병을 더 받았다' }] }, { settings: s, items: true });
+  assert.equal(rep.items.length, 1);
+  assert.equal(rep.items[0].action, 'update');
+  assert.equal(rep.items[0].uses, undefined);
+  assert.equal(rep.items[0].desc, R.leftWordIn(desc) || R.offWordIn(desc) ? '' : desc);
+  const rep2 = U.applyUpdate(T.emptyStore(), c, input, { items: [{ name: '생수', action: 'update', uses: 1, desc: '', m: 'm2', quote: '생수 두 병을 더 받았다' }] }, { settings: s, items: true });
+  assert.equal(rep2.items[0].uses, 1, '진짜 update 의 uses 는 그대로');
+});
+
+test('성적 지침: 고친 지침에도 「거짓일 때」 조건이 남는다 (기본 글)', () => {
+  const sec = X.sexualWriterSection({ ...St.peopleSettings({}), features: new Set(['axes']), sexualDesire: true, paraphilia: false, explicitStyle: false });
+  assert.ok(/When false[,:]/.test(sec));
+});
+
+test('변경 기록: 지워진 메시지의 변경은 버리고, 상한을 넘으면 오래된 계기를 값이 같게 접는다', () => {
+  const n = 260;
+  const chat = { message: Array.from({ length: n }, (_, i) => ({ role: i % 2 ? 'char' : 'user', data: `m${i}`, chatId: `k${i}` })) };
+  const store = T.emptyStore();
+  store.people.쟈알디 = person('쟈알디');
+  store.people.쟈알디.affinity.base = 20;
+  const cues = ['작은친절', '도움', '큰도움', '헌신', '실망', '무시', '배신'];
+  let seq = 0;
+  for (let i = 0; i < 820; i++) {
+    const at = 1 + (i % 25) * 2;
+    store.log.push({ id: `x${i}`, anchor: `k${at}`, seq: seq++, src: 'field', who: '쟈알디', kind: 'cue', cue: cues[i % cues.length] });
+  }
+  store.log.push({ id: 'late', anchor: `k${n - 1}`, seq: seq++, src: 'field', who: '쟈알디', kind: 'cue', cue: '헌신' });
+  store.log.push({ id: 'dead', anchor: 'gone', seq: seq++, src: 'field', who: '쟈알디', kind: 'cue', cue: '헌신' });
+  store.log.push({ id: 'hash', anchor: '#999', seq: seq++, src: 'field', who: '쟈알디', kind: 'cue', cue: '헌신' });
+  const o = { speed: 1, turnCap: 10 };
+  const live = S.liveness(chat);
+  const before = A.affinityOf(store.people.쟈알디, S.liveChanges(store, live), store.folded.쟈알디 ?? 0, o);
+  S.foldLog(store, chat, (who, list, folded) => A.sumCues(who, store.people[who].affinity.base, list, folded, T.AFF_MIN, T.AFF_MAX, o) - store.people[who].affinity.base);
+  const after = A.affinityOf(store.people.쟈알디, S.liveChanges(store, live), store.folded.쟈알디 ?? 0, o);
+  assert.ok(Math.abs(before - after) < 0.01, `${before} → ${after}`);
+  assert.deepEqual(store.log.map((c) => c.id).sort(), ['hash', 'late']);
+  // 고정이 든 사람은 접지 않는다
+  const s2 = T.emptyStore();
+  s2.people.쟈알디 = person('쟈알디');
+  for (let i = 0; i < 801; i++) s2.log.push({ id: `y${i}`, anchor: `k${1 + (i % 50) * 2}`, seq: i, src: 'field', who: '쟈알디', kind: 'cue', cue: '도움', ...(i === 3 ? { pin: 50, cue: undefined } : {}) });
+  S.foldLog(s2, chat, () => 0);
+  assert.equal(s2.log.length, 801);
+});
diff --git a/tests/fix2-phone.test.mjs b/tests/fix2-phone.test.mjs
new file mode 100644
index 0000000000..dfa2e79508
--- /dev/null
+++ b/tests/fix2-phone.test.mjs
@@ -0,0 +1,60 @@
+// 괴담톡 전수검사 11-13 고침: JSON 뒤 군말·닫히지 않은 칸, 넣을 공지 0개, 수다 줄 수 상한
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { build } from 'esbuild';
+import { mkdir } from 'node:fs/promises';
+import { join } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+const dir = '/tmp/audit_1113/fix2/phone';
+await mkdir(dir, { recursive: true });
+await build({
+  entryPoints: ['src/core/phone.ts'],
+  outdir: dir, outbase: 'src', bundle: true, platform: 'node', format: 'esm', outExtension: { '.js': '.mjs' }, logLevel: 'silent',
+});
+const P = await import(pathToFileURL(join(dir, 'core/phone.mjs')));
+
+const room = (kind, members) => ({ id: `${kind}_1`, kind, members, people: Object.fromEntries(members.map((c) => [c, { id: c, name: c }])), messages: [], draft: '', unread: 0 });
+const add = (content, sender) => ({ op: 'add', path: '/messages/-', value: { content, sender, type: 'text' } });
+
+test('decodeJson: JSON 뒤 군말·닫히지 않은 말버릇 칸은 버리고 읽는다', () => {
+  assert.deepEqual(P.decodeJson('{"updates":[{"a":1}]}\n이상입니다.'), { updates: [{ a: 1 }] });
+  assert.deepEqual(P.decodeJson('{"updates":[],"x":"}{"}\n<ph-habits>[{"sender":"c_1","note":"짧게'), { updates: [], x: '}{' });
+  assert.deepEqual(P.decodeJson('[1,2,]\n끝'), [1, 2], '군말을 뗀 뒤 쉼표 고치기도 한다');
+  assert.deepEqual(P.decodeJson('{"a":1}'), { a: 1 });
+  assert.throws(() => P.decodeJson('{"updates":[{"a":1}'), /JSON 문법 오류/, '정말 끊긴 JSON은 그대로 실패');
+  assert.deepEqual(P.parseHabits('{"a":1}\n<ph-habits>[{"sender":"c_1","note":"x"}'), [], '닫히지 않은 칸은 저장하지 않는다');
+});
+
+test('parseReply: 닫는 표식이 빠져도 읽는다', () => {
+  const r = room('dm', ['c_1']);
+  const raw = `<lb-minitalk-patch>${JSON.stringify([add('안녕', 'c_1'), add('뭐해', 'c_1')])}`;
+  assert.deepEqual(P.parseReply(raw, r, false).events.map((e) => e.text), ['안녕', '뭐해']);
+});
+
+test('넣을 공지 0개면 공지를 싣지 않는다', () => {
+  const st = P.blankState();
+  const b = { version: 2, seq: 1, items: [1, 2, 3].map((id) => ({ id, order: id, read: true, channel: 'A00', channelName: '관리국', issuer: '총무과', category: '공지', title: `t${id}`, text: 'x', time: '' })), checks: {}, seen: {} };
+  const old = P.HISTORY.contextNotices;
+  try {
+    P.HISTORY.contextNotices = 0;
+    const out = P.mainContext(st, b, P.phoneSettings({}), 'R');
+    assert.ok(!/announcement/.test(out), '공지 0개');
+    P.HISTORY.contextNotices = 1;
+    const one = JSON.parse(P.mainContext(st, b, P.phoneSettings({}), 'R').split('\n')[2]);
+    assert.equal(one.records.filter((x) => x.kind === 'announcement').length, 1);
+  } finally {
+    P.HISTORY.contextNotices = old;
+  }
+});
+
+test('수다 줄 수가 12보다 크면 그 요청의 방 상한도 따라간다', () => {
+  const state = { '$ph_banter_min': '20', '$ph_banter_max': '30' };
+  assert.equal(P.eventCap(state, true), 30);
+  assert.equal(P.eventCap(state, false), P.LIMITS.events);
+  assert.equal(P.eventCap({}, true), P.LIMITS.events, '기본(6~12)은 그대로');
+  const r = room('group', ['c_1', 'c_2']);
+  const events = Array.from({ length: 25 }, (_, i) => ({ type: 'message', sender: i % 2 ? 'c_1' : 'c_2', text: `말${i}` }));
+  assert.equal(P.keepValid(events, r).length, P.LIMITS.events);
+  assert.equal(P.keepValid(events, r, [], 30).length, 25);
+});
diff --git a/tests/fix2-pipe.test.mjs b/tests/fix2-pipe.test.mjs
new file mode 100644
index 0000000000..0948d6a535
--- /dev/null
+++ b/tests/fix2-pipe.test.mjs
@@ -0,0 +1,116 @@
+// 전수검사 11-13 고침: 지시문 풀기(마지막 카드·Situation 틀), 생각 칸 지우기, 상태창 거래 줄, 호출 기록 턴별 저장
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { build } from 'esbuild';
+import { mkdirSync } from 'node:fs';
+import { join } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+const dir = '/tmp/audit_1113/fix2/pipe';
+mkdirSync(dir, { recursive: true });
+const S = JSON.stringify;
+await build({
+  stdin: {
+    contents: `
+      export { unwrapScenes, unwrapCalls } from './src/core/request';
+      export { sceneRecord } from './src/core/dispatch';
+      export { setGuideOverride, guideDefault } from './src/core/guides';
+      export { callRecord } from './src/core/phone';
+      export { stripThoughts } from './src/host/llm';
+      export { withStatusBlock } from './src/core/statusctx';
+      export { traceBegin, traceMain, traceCall, loadTrace, clearTrace } from './src/host/trace';
+    `,
+    resolveDir: process.cwd(), loader: 'ts',
+  },
+  outfile: join(dir, 'pipe.mjs'), bundle: true, platform: 'node', format: 'esm', logLevel: 'silent',
+  loader: { '.txt': 'text', '.css': 'text' },
+  define: { __UPDATE_BASE__: S(''), __PLUGIN_VERSION__: S('0.0.0'), __WORLD_PACK__: S('{}'), __INSTALL_PACK__: S('{}'), __ITEMS_PACK__: S('{}'), __LOOKS_PACK__: S('{}'), __HOMESHOP_PACK__: S('{}') },
+});
+
+// 가짜 플러그인 저장소
+const store = new Map();
+globalThis.risuai = {
+  pluginStorage: {
+    getItem: async (k) => (store.has(k) ? store.get(k) : null),
+    setItem: async (k, v) => void store.set(k, v),
+    removeItem: async (k) => void store.delete(k),
+    keys: async () => [...store.keys()],
+  },
+};
+const url = pathToFileURL(join(dir, 'pipe.mjs')).href;
+const M = await import(url);
+
+test('지시문: 카드가 채팅의 마지막이면 뒤의 프리셋 user 글을 합치지 않는다', () => {
+  const rec = M.sceneRecord({ target: 'T', party: 'P' }, 'BODY');
+  const msgs = [{ role: 'user', content: rec }, { role: 'user', content: '<Preset> 끝 지시' }];
+  assert.deepEqual(M.unwrapScenes(msgs, { cardIsLast: true }).messages.map((m) => m.content), ['BODY', '<Preset> 끝 지시']);
+  // 옵션 없으면 전과 같다
+  assert.deepEqual(M.unwrapScenes(msgs).messages.map((m) => m.content), ['BODY\n\nSituation:\n<Preset> 끝 지시']);
+  // 같은 메시지의 「추가 요청」 꼬리는 그대로 합친다
+  const tail = M.unwrapScenes([{ role: 'user', content: `${rec}\n문을 연다` }, { role: 'user', content: 'P' }], { cardIsLast: true }).messages.map((m) => m.content);
+  assert.deepEqual(tail, ['BODY\n\nSituation:\n문을 연다', 'P']);
+});
+
+test('지시문: Situation 틀은 지침 FORMAT.user_input 을 쓰고, 지침이 깨지면 기본 글', () => {
+  const rec = M.sceneRecord({ target: 'T', party: 'P' }, 'BODY');
+  const def = M.guideDefault('Directive');
+  assert.ok(def.includes('"user_input": "Situation:\\n[[INPUT]]"'));
+  try {
+    M.setGuideOverride('Directive', def.replace('"user_input": "Situation:\\n[[INPUT]]"', '"user_input": "상황:\\n[[INPUT]]"'));
+    assert.equal(M.unwrapScenes([{ role: 'user', content: rec }, { role: 'user', content: '간다' }]).messages[0].content, 'BODY\n\n상황:\n간다');
+    M.setGuideOverride('Directive', def.replace('===OPENING===', '===OPEN==='));
+    assert.equal(M.unwrapScenes([{ role: 'user', content: rec }, { role: 'user', content: '간다' }]).messages[0].content, 'BODY\n\nSituation:\n간다');
+  } finally {
+    M.setGuideOverride('Directive', '');
+  }
+});
+
+test('전화: 기록이 채팅의 마지막이면 뒤의 user 글을 통화 내용으로 합치지 않는다', () => {
+  const rec = M.callRecord('쟈알디', '보고');
+  const msgs = [{ role: 'user', content: rec }, { role: 'user', content: '<Preset>' }];
+  assert.deepEqual(M.unwrapCalls(msgs, { callIsLast: true }).messages.map((m) => m.content), ['{{user}} places a phone call to 쟈알디.\n\n보고', '<Preset>']);
+  assert.equal(M.unwrapCalls(msgs).messages.length, 1);
+});
+
+test('생각 칸: <thinking> 도 지우고, 맨 앞의 닫히지 않은 칸은 답 줄부터 남긴다', () => {
+  assert.equal(M.stripThoughts('<thinking>{a}</thinking>{"x":1}'), '{"x":1}');
+  assert.equal(M.stripThoughts('<think>a</think>b'), 'b');
+  assert.equal(M.stripThoughts('<lb-process>\nstep\n{"x":1}'), '{"x":1}');
+  assert.equal(M.stripThoughts('<lb-process>\nstep\n<lb-result>ok</lb-result>'), '<lb-result>ok</lb-result>');
+  assert.equal(M.stripThoughts('<lb-process>\nonly thoughts'), '');
+  assert.equal(M.stripThoughts('답\n<think>tail'), '답\n');
+});
+
+test('상태창: 거래 줄은 기본 지침이면 전과 같은 글', () => {
+  const msgs = [{ role: 'assistant', content: '본문\n[▣|2025.01.01|02:47 AM|☀️|4°C|남해지사|없음]' }, { role: 'user', content: 'go' }];
+  const block = M.withStatusBlock(msgs, '', { cols: ['date', 'time', 'weather', 'temp', 'place', 'target'], recent: ['a', 'b'], recentPoints: ['p'] }).find((m) => m.role === 'system')?.content ?? '';
+  assert.ok(block.endsWith('\nRecent cash transactions (oldest first): a; b\nRecent Baekilmong point transactions (oldest first): p'), block);
+  const none = M.withStatusBlock(msgs, '', { cols: ['date', 'time', 'weather', 'temp', 'place', 'target'], recent: [], recentPoints: [] }).find((m) => m.role === 'system')?.content ?? '';
+  assert.ok(none && !none.includes('Recent'), none);
+});
+
+test('호출 기록: 턴마다 따로 저장하고 다시 읽으면 같다', async () => {
+  await M.traceBegin();
+  M.traceMain([{ role: 'user', content: '안녕하세요' }], []);
+  await M.traceCall({ label: '라우터', at: new Date().toISOString(), ms: 1, model: 'aux', ok: true, request: 'q', requestChars: 1, response: 'r', responseChars: 1 });
+  await new Promise((r) => setTimeout(r, 1700));
+  const idx = JSON.parse(store.get('goei-trace'));
+  assert.equal(idx.length, 1);
+  assert.equal(typeof idx[0], 'string');
+  const saved = JSON.parse(store.get(`goei-trace:${idx[0]}`));
+  assert.equal(saved.calls.length, 1);
+  assert.equal(typeof saved.main.totalTokens, 'number');
+  // 새 모듈로 다시 읽기
+  const N = await import(`${url}?v=2`);
+  const back = await N.loadTrace();
+  assert.equal(back.length, 1);
+  assert.equal(back[0].id, idx[0]);
+  // 옛 모양(턴 배열 통째)도 읽는다
+  store.clear();
+  store.set('goei-trace', JSON.stringify([{ id: 'old1', at: 'x', calls: [] }]));
+  const O = await import(`${url}?v=3`);
+  assert.deepEqual((await O.loadTrace()).map((t) => t.id), ['old1']);
+  await O.clearTrace();
+  assert.equal(store.get('goei-trace'), '[]');
+  assert.ok(![...store.keys()].some((k) => k.startsWith('goei-trace:')));
+});
