+// 전수검사 11-13 고침 확인: 지침 칸에 ##·### 줄을 쳐도 다른 절을 덮지 않는다(guides#1), 저장 중에 친 글이 남는다(guides#8),
+// 머리 토큰 수는 입력이 멈춘 뒤 센다(guides#6·perf#3)
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { build } from 'esbuild';
+import { mkdir } from 'node:fs/promises';
+import { join, resolve } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+const dir = '/tmp/audit_1113/fix2/editor';
+await mkdir(dir, { recursive: true });
+
+// 저장소(host/prefs)는 가짜로: 저장은 globalThis.__hold 가 풀릴 때까지 기다린다
+const stubPrefs = {
+  name: 'stub-prefs',
+  setup(b) {
+    b.onResolve({ filter: /host\/prefs$/ }, () => ({ path: 'prefs-stub', namespace: 'stub' }));
+    b.onLoad({ filter: /.*/, namespace: 'stub' }, () => ({
+      contents: `export async function savePrefs(change) { if (globalThis.__hold) await globalThis.__hold; const p = change(globalThis.__prefs ?? {}); globalThis.__prefs = p; return p; }
+export async function loadPrefs() { return globalThis.__prefs ?? {}; }
+export async function saveVarDefaults() {}
+export function loadVarDefaults() { return {}; }`,
+      loader: 'js',
+    }));
+  },
+};
+await build({
+  entryPoints: { guides: 'src/ui/editor/guides.ts', core: 'src/core/guides.ts' },
+  outdir: dir, bundle: true, platform: 'node', format: 'esm', outExtension: { '.js': '.mjs' }, loader: { '.txt': 'text' }, logLevel: 'silent', plugins: [stubPrefs],
+});
+const G = await import(pathToFileURL(resolve(join(dir, 'guides.mjs'))));
+const wait = (ms) => new Promise((r) => setTimeout(r, ms));
+
+/** 화면 글칸처럼: 그린 때의 칸 순번과 본문 */
+function draw(name) {
+  const html = G.guidePage(name);
+  const boxes = [...html.matchAll(/data-input="ed-guide-sec" data-key="([^"]+)"[^>]*>\n([\s\S]*?)<\/textarea>/g)].map((m) => ({ key: m[1], body: m[2].replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&amp;/g, '&') }));
+  return boxes;
+}
+
+test('지침 칸 본문에 ### 줄을 한 글자씩 쳐도 절이 불어나지 않고, 아래 칸이 다른 절을 덮지 않는다', () => {
+  const name = 'RP';
+  const before = G.guidePage(name) && draw(name);
+  assert.ok(before.length >= 3, 'RP 는 절이 여럿');
+  const start = before.map((b) => b.body);
+  const add = '\n### My rule\n- be brief';
+  let v = before[1].body;
+  for (const ch of add) {
+    v += ch;
+    G.guideInput('ed-guide-sec', before[1].key, v);
+  }
+  // 아래 칸에 한 글자
+  G.guideInput('ed-guide-sec', before[2].key, `${before[2].body}!`);
+  const draft = G.guideUi.draft[name];
+  assert.equal((draft.match(/### My rule/g) ?? []).length, 1, '친 제목은 한 번만');
+  assert.ok(draft.includes(`${start[2]}!`), '아래 절 본문은 그대로에 「!」만 붙는다');
+  for (const [i, b] of start.entries()) if (i !== 1 && i !== 2) assert.ok(draft.includes(b), `${i}번 절이 남는다`);
+  // 다시 그리면 친 제목이 제 절이 된다
+  const after = draw(name);
+  assert.equal(after.length, before.length + 1);
+});
+
+test('지침 저장 중에 더 친 글은 지우지 않는다', async () => {
+  const name = 'Tag';
+  const boxes = draw(name);
+  G.guideInput('ed-guide-sec', boxes[0].key, `${boxes[0].body}A`);
+  let release;
+  globalThis.__hold = new Promise((r) => { release = r; });
+  const saving = G.guideAction('ed-guide-save', name);
+  G.guideInput('ed-guide-sec', boxes[0].key, `${boxes[0].body}AB`);
+  release();
+  await saving;
+  globalThis.__hold = undefined;
+  assert.ok(G.guideUi.draft[name]?.includes(`${boxes[0].body}AB`), '더 친 글이 남아 다음 저장을 기다린다');
+  await G.guideAction('ed-guide-save', name);
+  assert.ok(globalThis.__prefs.guides[name].includes(`${boxes[0].body}AB`), '다음 저장이 넣는다');
+  assert.equal(G.guideUi.draft[name], undefined);
+});
+
+test('머리 토큰 수는 입력이 멈추고 나서 센다', async () => {
+  const name = 'RP';
+  const boxes = draw(name);
+  const tok = { textContent: '이전' };
+  const root = { querySelector: (s) => (s === '.gw-head .gw-tokens' ? tok : s.startsWith('[data-key^="RP|"]') ? {} : null) };
+  G.guideBarSync(root, name);
+  G.guideBarSync(root, name);
+  assert.equal(tok.textContent, '이전', '바로는 세지 않는다');
+  await wait(400);
+  assert.match(tok.textContent, /토큰$/);
+  // 그새 다른 지침으로 옮겼으면 쓰지 않는다
+  tok.textContent = '다른';
+  G.guideBarSync({ querySelector: (s) => (s === '.gw-head .gw-tokens' ? tok : null) }, name);
+  await wait(400);
+  assert.equal(tok.textContent, '다른');
+  void boxes;
+});
diff --git a/tests/fix2-editor2.test.mjs b/tests/fix2-editor2.test.mjs
new file mode 100644
index 0000000000..4b39dcd6e0
--- /dev/null
+++ b/tests/fix2-editor2.test.mjs
@@ -0,0 +1,63 @@
+// 전수검사 11-13 고침 확인: 추가 규칙 저장 순서(guides#9), 호출 흐름 「지난 턴」 이름표(editor#8)
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { build } from 'esbuild';
+import { mkdir } from 'node:fs/promises';
+import { join, resolve } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+const dir = '/tmp/audit_1113/fix2/editor2';
+await mkdir(dir, { recursive: true });
+
+// 저장소(host/prefs)는 가짜로: 저장된 목록을 globalThis 에 남긴다
+const stubPrefs = {
+  name: 'stub-prefs',
+  setup(b) {
+    b.onResolve({ filter: /host\/prefs$/ }, () => ({ path: 'prefs-stub', namespace: 'stub' }));
+    b.onLoad({ filter: /.*/, namespace: 'stub' }, () => ({
+      contents: `export async function savePrefs(change) { const p = change(globalThis.__prefs ?? {}); globalThis.__prefs = p; return p; }
+export async function loadPrefs() { return globalThis.__prefs ?? {}; }
+export async function saveVarDefaults() {}
+export function loadVarDefaults() { return {}; }`,
+      loader: 'js',
+    }));
+  },
+};
+await build({
+  entryPoints: { rules: 'src/ui/editor/rules.ts', progress: 'src/core/progress.ts' },
+  outdir: dir, bundle: true, platform: 'node', format: 'esm', outExtension: { '.js': '.mjs' }, loader: { '.txt': 'text' }, logLevel: 'silent', plugins: [stubPrefs],
+});
+const R = await import(pathToFileURL(resolve(join(dir, 'rules.mjs'))));
+const P = await import(pathToFileURL(resolve(join(dir, 'progress.mjs'))));
+const wait = (ms) => new Promise((r) => setTimeout(r, ms));
+
+test('추가 규칙: 글을 친 직후 켜기·새 규칙을 눌러도 0.4초 뒤 되돌려지지 않는다', async () => {
+  globalThis.__prefs = {};
+  await R.ruleAction('ed-rule-new');
+  const [r1] = globalThis.__prefs.rules;
+  assert.equal(r1.on, true);
+  R.ruleInput('ed-rule-text', r1.id, '한 번에 세 문장까지');
+  await R.ruleAction('ed-rule-on', r1.id);
+  await R.ruleAction('ed-rule-new');
+  await wait(500);
+  const saved = globalThis.__prefs.rules;
+  assert.equal(saved.length, 2, '새 규칙이 남는다');
+  assert.equal(saved[0].on, false, '끈 것이 남는다');
+  assert.equal(saved[0].text, '한 번에 세 문장까지', '친 글도 남는다');
+});
+
+test('추가 규칙: 글만 치면 0.4초 뒤 저장된다', async () => {
+  const id = globalThis.__prefs.rules[1].id;
+  R.ruleInput('ed-rule-title', id, '대사 길이');
+  await wait(500);
+  assert.equal(globalThis.__prefs.rules[1].title, '대사 길이');
+});
+
+test('호출 흐름 지난 턴: 다시 묻기·다시 보기·통합 뒤 따로 꼬리를 뗀 이름으로 센다', () => {
+  const b = P.baseLabel;
+  assert.equal(b('갱신기 다시 묻기 1'), '갱신기');
+  assert.equal(b('괴담톡 확인 다시 보기 2'), '괴담톡 확인');
+  assert.equal(b('괴담톡+괴담넷 통합 다시 묻기'), '괴담톡+괴담넷 통합');
+  assert.equal(b('괴담톡 (통합 뒤 따로)'), '괴담톡');
+  assert.equal(b('라우터'), '라우터');
+});
diff --git a/tests/fix2-gnetwiki.test.mjs b/tests/fix2-gnetwiki.test.mjs
new file mode 100644
index 0000000000..ca3bd68fb4
--- /dev/null
+++ b/tests/fix2-gnetwiki.test.mjs
@@ -0,0 +1,69 @@
+// 전수검사 11-13 게시판 고침 시험 2: 되살린 글이 새로고침에 유지돼도 기한(back) 유지, 이번 턴에 쓴 글·댓글 단 글은 본편 요청에 꼭 넣기
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { build } from 'esbuild';
+import { mkdir } from 'node:fs/promises';
+import { join } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+const dir = '/tmp/audit_1113/fix2/gnetwiki';
+await mkdir(dir, { recursive: true });
+await build({
+  entryPoints: ['src/core/gnet.ts'],
+  outdir: dir, bundle: true, platform: 'node', format: 'esm', outExtension: { '.js': '.mjs' }, loader: { '.txt': 'text' }, logLevel: 'silent',
+});
+const G = await import(pathToFileURL(join(dir, 'gnet.mjs')));
+
+const S = (over = {}) => G.gnetSettings(Object.fromEntries(Object.entries(over).map(([k, v]) => [G.CFG(k), v])));
+const B = G.G_POST_BASE;
+const post = (id, extra = {}) => ({ id, date: '2025.05.13 14:00', nick: `n${id}`, title: `t${id}`, views: 10, votes: 1, body: `b${id}`, mine: false, comments: [], ...extra });
+const msgs = (n) => Array.from({ length: n }, () => [{ role: 'user', data: 'u' }, { role: 'char', data: '응답' }]).flat();
+const scene = { scene: '', terms: [] };
+const titles = (t) => (t ? JSON.parse(t.split('\n')[2]).records.map((r) => r.title) : []);
+
+test('되살린 글을 모델이 유지해도 back 이 남아 본편 응답 뒤 보관함으로 간다', () => {
+  const st = { seq: B + 5, posts: [post(B + 5)], archive: [post(B + 1, { mine: true, nick: '나', title: '옛 글' })], dms: [], sources: {} };
+  let chat = G.writeGnet({ message: msgs(2), scriptstate: {} }, st);
+  const cur = G.readGnet(chat);
+  G.addUserComment(cur, B + 1, 0, '나', '댓글', '2025.05.13 15:10', 2);
+  chat = G.writeGnet(chat, cur);
+  const before = G.readGnet(chat);
+  const value = { posts: [{ id: B + 1, author: '나', title: '옛 글', content: 'x', comments: [] }, { id: B + 5, author: 'n', title: 't', content: 'b', comments: [] }] };
+  const res = G.applyBoard(before, structuredClone(before), value, { nick: '나', settings: S(), date: '2025.05.13 16:00' });
+  assert.equal(res.st.posts.find((p) => p.id === B + 1)?.back, 2, '유지된 글에 back 이 남는다');
+  chat = G.writeGnet(chat, res.st);
+  const next = G.readGnet({ ...chat, message: msgs(3) });
+  assert.ok(next.archive.some((p) => p.id === B + 1) && !next.posts.some((p) => p.id === B + 1), '본편 응답이 오면 보관함으로');
+});
+
+test('이번 턴에 쓴 글·댓글 단 옛 글은 장면과 무관해도 본편 요청에 들어가고, 다음 턴에는 빠진다', () => {
+  const posts = Array.from({ length: 9 }, (_, i) => post(B + 1 + i, { title: `글 ${i + 1}` })).reverse();
+  const st = { seq: B + 9, posts, archive: [], dms: [], sources: {} };
+  let chat = G.writeGnet({ message: msgs(4), scriptstate: {} }, st);
+  const cur = G.readGnet(chat);
+  G.addUserComment(cur, B + 3, 0, '나', '내 댓글', '2025.05.13 15:10', 4);
+  chat = G.writeGnet(chat, cur);
+  const now = G.readGnet(chat);
+  assert.equal(now.posts.find((p) => p.id === B + 3)?.touch, 4, '저장·읽기에서 touch 유지');
+  assert.equal(now.posts.find((p) => p.id === B + 3)?.back, undefined, '게시판에 있던 글은 보관함 기한이 붙지 않는다');
+  const got = titles(G.mainContext(now, '나', '', scene));
+  assert.ok(got.includes('글 3') && got.includes('글 9'), got.join(','));
+  const later = G.readGnet({ ...chat, message: msgs(5) });
+  assert.equal(later.posts.find((p) => p.id === B + 3)?.touch, undefined);
+  assert.ok(!titles(G.mainContext(later, '나', '', scene)).includes('글 3'), '다음 턴에는 다시 장면 기준');
+});
+
+test('내가 쓴 글은 더 새 글이 생겨도 그 턴에는 들어간다. 턴을 안 주면 예전 그대로', () => {
+  const st = { seq: B + 1, posts: [post(B + 1, { title: '남의 글' })], archive: [], dms: [], sources: {} };
+  G.addUserPost(st, '나', '내 글', '본문', '2025.05.13 15:00', 2);
+  st.posts.unshift(post(B + 50, { title: '더 새 글' }));
+  st.seq = B + 50;
+  const got = titles(G.mainContext(st, '나', '', scene));
+  assert.ok(got.includes('내 글') && got.includes('더 새 글'), got.join(','));
+  const p = G.addUserPost(st, '나', '턴 없음', '본문', '');
+  assert.equal(p.touch, undefined);
+  // back 없이 touch 만 있는 줄도 읽고 쓴다
+  const back = G.decode(G.encode(st));
+  assert.equal(back.posts.find((q) => q.title === '내 글')?.touch, 2);
+  assert.equal(back.posts.find((q) => q.title === '내 글')?.back, undefined);
+});
diff --git a/tests/fix2-img.test.mjs b/tests/fix2-img.test.mjs
new file mode 100644
index 0000000000..96d4e5cc84
--- /dev/null
+++ b/tests/fix2-img.test.mjs
@@ -0,0 +1,49 @@
+// 전수검사 11-13 이미지 고침: 밑줄 표정 태그, 이미지 지침 {{user}} 풀기, 상황 카드 설명 캐시
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { build } from 'esbuild';
+import { mkdir } from 'node:fs/promises';
+import { join } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+const dir = '/tmp/audit_1113/fix2/img';
+await mkdir(dir, { recursive: true });
+await build({
+  entryPoints: ['src/core/imgtag.ts', 'src/core/imgprompt.ts', 'src/ui/evpic.ts', 'src/core/wiki.ts'],
+  outdir: dir, outbase: 'src', bundle: true, platform: 'node', format: 'esm', outExtension: { '.js': '.mjs' }, logLevel: 'silent',
+});
+const mod = async (n) => import(pathToFileURL(join(dir, `${n}.mjs`)));
+const T = await mod('core/imgtag');
+const P = await mod('core/imgprompt');
+const E = await mod('ui/evpic');
+const W = await mod('core/wiki');
+
+test('밑줄로 쓴 띄어쓰기 표정도 그림 칸이 된다', () => {
+  const pick = (n) => (n.toLowerCase() === 'aileen_forced smiling' ? 'Aileen_forced smiling' : null);
+  const out = T.renderImgTags('a\n<img=Aileen_forced_smiling>\nb', pick);
+  assert.ok(out.includes('{{raw::Aileen_forced smiling}}'), out);
+  assert.ok(T.renderImgTags('<img=Aileen_forced smiling>', pick).includes('{{raw::Aileen_forced smiling}}'));
+  // 목록이 없을 때도 표정 세트로 믿는다
+  assert.ok(T.renderImgTags('<img=Aileen_angry_smile>').includes('{{raw::Aileen_angry smile}}'));
+  // 없는 표정은 그대로 빠진다
+  assert.equal(T.renderImgTags('a<img=Aileen_no_such>b', pick), 'a\n\nb');
+});
+
+test('이미지 지침: 이름을 주면 {{user}}를 풀고, 안 주면 그대로', () => {
+  const cfg = P.imgPromptConfig({});
+  const raw = P.buildImgPrompt(cfg, ['Jyaldi'], false);
+  assert.ok(raw.includes('{{user}}'));
+  const named = P.buildImgPrompt(cfg, ['Jyaldi'], false, '영지');
+  assert.ok(!named.includes('{{user}}') && named.includes('Do not create tags for 영지.'), named);
+  assert.equal(P.buildImgPrompt(cfg, ['Jyaldi'], false, ' '), raw);
+});
+
+test('상황 카드 설명: 위키 문서가 생기면 새로 읽는다', () => {
+  const char = { globalLore: [] };
+  let chat = { localLore: [] };
+  assert.equal(E.evArt({ char, chat }, '명일 아파트').desc, '');
+  chat = W.saveDoc(chat, { title: '명일 아파트' }, '<lightboard-namuwiki>\n[Paragraph]낡은 아파트.\n</lightboard-namuwiki>');
+  assert.equal(E.evArt({ char, chat }, '명일 아파트').desc, '낡은 아파트.');
+  // 다른 채팅에는 그 문서가 없다
+  assert.equal(E.evArt({ char, chat: { localLore: [] } }, '명일 아파트').desc, '');
+});
diff --git a/tests/fix2-items.test.mjs b/tests/fix2-items.test.mjs
new file mode 100644
index 0000000000..812a0b1f7d
--- /dev/null
+++ b/tests/fix2-items.test.mjs
@@ -0,0 +1,107 @@
+// 전수검사 11-13: 소지품 — 다시 켬 오판(setwire#2·items#3), 이어 받은 응답의 이중 사용(items#5), 한도 정리(items#7),
+// 다 쓴·판 같은 이름 직접 넣기(items#8), 남겨 두기의 다 씀(items#11), Recently 줄(items#12)
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { build } from 'esbuild';
+import { mkdir } from 'node:fs/promises';
+import { join } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+const dir = '/tmp/audit_1113/fix2/items';
+await mkdir(dir, { recursive: true });
+await build({
+  entryPoints: ['src/core/items.ts'],
+  outdir: dir, outbase: 'src', bundle: true, platform: 'node', format: 'esm', outExtension: { '.js': '.mjs' }, loader: { '.txt': 'text' }, logLevel: 'silent',
+});
+const I = await import(pathToFileURL(join(dir, 'core/items.mjs')));
+const empty = { list: [], log: [] };
+const msg = (role, chatId) => ({ role, data: chatId, chatId });
+
+test('다시 켬: 변수가 없거나 빈 칸이면 새 채팅 첫 턴에 「꺼졌다 켜짐」을 붙이지 않는다', () => {
+  const first = { message: [msg('user', 'u1')], scriptstate: {} };
+  assert.equal(I.invJustResumed(first), false);
+  assert.equal(I.invJustResumed({ ...first, scriptstate: { [I.ITEM_RESUMED_VAR]: '' } }), false);
+  assert.doesNotMatch(I.inventoryText(first), /switched off/);
+  // 진짜로 다시 켠 때(메시지 수가 적힘)는 그대로
+  const chat = { message: [msg('user', 'u1'), msg('char', 'b1'), msg('user', 'u2')], scriptstate: { [I.ITEM_RESUMED_VAR]: '3' } };
+  assert.equal(I.invJustResumed(chat), true);
+});
+
+test('사용: 유저 메시지 없이 이어 받은 응답은 같은 사용을 또 빼지 않고, 진짜 리롤은 새 응답에 다시 묶는다', () => {
+  const it = I.addItem(empty, new Set(['b1']), { name: '진통제', uses: 3, from: 'story', anchor: 'b1' });
+  const id = it.list[0].id;
+  const chat = { message: [msg('user', 'u1'), msg('char', 'b1'), msg('user', 'u2'), msg('char', 'b2')], scriptstate: { ...I.itemsVars(it), ...I.itemUseVars([{ id, n: 1 }]) } };
+  Object.assign(chat.scriptstate, I.settleItemUse(chat, 3));
+  chat.message.push(msg('char', 'b3'));
+  const v = I.settleItemUse(chat, 4);
+  const after = v ? I.readItems({ ...chat.scriptstate, ...v }) : I.readItems(chat.scriptstate);
+  assert.deepEqual(after.log.filter((l) => l.what === 'use').map((l) => l.anchor), ['b2']);
+  assert.equal(I.itemLeft(after, after.list[0], new Set(['u1', 'b1', 'u2', 'b2', 'b3'])), 2);
+  // 진짜 리롤: 옛 응답이 사라지고 새 응답이 그 자리에
+  chat.message.pop();
+  chat.message[3] = msg('char', 'b4');
+  const again = I.readItems(I.settleItemUse(chat, 3));
+  assert.deepEqual(again.log.filter((l) => l.what === 'use').map((l) => l.anchor), ['b2', 'b4']);
+});
+
+test('한도 정리: 시작 장비는 남고, 다 쓴 소모품은 기록이 넘쳐도 되살지 않는다', () => {
+  let it = I.startItemsState([{ name: '제식 권총', equip: 'weapon' }, { name: '방검복', equip: 'gear' }]);
+  const alive = new Set(['a0', 'a1']);
+  for (let i = 0; i < 205; i++) it = I.addItem(it, alive, { name: `물건${i}`, from: 'story', anchor: i < 150 ? `dead${i}` : 'a1' });
+  assert.ok(it.list.length <= 200);
+  assert.deepEqual(I.liveItems(it, alive).filter((e) => e.anchor === '').map((e) => e.name), ['제식 권총', '방검복']);
+  // 다 쓴 진통제 + 죽은 기록 400줄
+  let u = I.addItem(empty, alive, { name: '진통제', uses: 3, from: 'manual', anchor: '' });
+  const pid = u.list[0].id;
+  u = I.addItemLog(u, { name: '진통제', item: pid, what: 'use', by: 'use', anchor: 'a0', n: 3 }, alive);
+  for (let i = 0; i < 420; i++) u = I.addItemLog(u, { name: `x${i}`, what: 'get', by: 'story', anchor: `dead${i}` }, alive);
+  assert.ok(u.log.length <= 400);
+  assert.equal(I.liveItems(u, alive).length, 0, '다 쓴 진통제가 되살지 않는다');
+  // 살아 있는 사용 기록만 넘쳐도 남은 횟수는 그대로 (처음 횟수에서 먼저 뺀다)
+  let w = I.addItem(empty, alive, { name: '붕대', uses: 999, from: 'manual', anchor: '' });
+  const bid = w.list[0].id;
+  for (let i = 0; i < 450; i++) w = I.addItemLog(w, { name: '붕대', item: bid, what: 'use', by: 'use', anchor: 'a1' }, alive);
+  assert.ok(w.log.length <= 400);
+  assert.equal(I.itemLeft(w, w.list[0], alive), 999 - 450);
+  // 읽을 때 자르지 않는다
+  assert.equal(I.readItems(I.itemsVars(w)).log.length, w.log.length);
+});
+
+test('직접 넣기: 다 쓴·판 같은 이름이 남아 있어도 새로 들어간다. 본문은 같은 응답을 다시 읽어도 되살지 않는다', () => {
+  const alive = new Set(['c1', 'c2']);
+  let it = I.addItem(empty, alive, { name: '붕대', uses: 1, from: 'manual', anchor: '' });
+  it = I.addItemLog(it, { name: '붕대', item: it.list[0].id, what: 'use', by: 'use', anchor: 'c1', n: 1 });
+  assert.equal(I.liveItems(it, alive).length, 0);
+  it = I.addItem(it, alive, { name: '붕대', uses: 3, from: 'manual', anchor: '' });
+  assert.deepEqual(I.liveItems(it, alive).map((e) => [e.name, I.itemLeft(it, e, alive)]), [['붕대', 3]]);
+  let g = I.addItem(empty, alive, { name: '권총', from: 'manual', anchor: '' });
+  g = I.sellItem(g, g.list[0].id, 'c2', '철물점에 팖');
+  g = I.addItem(g, alive, { name: '권총', from: 'manual', anchor: '' });
+  assert.deepEqual(I.liveItems(g, alive).map((e) => e.name), ['권총']);
+  let s = I.addItem(empty, alive, { name: '생수', uses: 1, from: 'story', anchor: 'c1' });
+  s = I.addItemLog(s, { name: '생수', item: s.list[0].id, what: 'use', by: 'use', anchor: 'c2', n: 1 });
+  assert.equal(I.addItem(s, alive, { name: '생수', uses: 1, from: 'story', anchor: 'c1' }), s);
+});
+
+test('남겨 두기: 본문이 다 썼다고 하면 「다 씀」(남은 0)으로 남고, 그 응답을 다시 굴리면 돌아온다', () => {
+  const alive = new Set(['c1', 'c2']);
+  let it = { ...I.addItem(empty, alive, { name: '생수', uses: 3, from: 'story', anchor: 'c1' }), keep: true };
+  it = I.applyItemChanges(it, alive, [{ action: 'update', name: '생수', uses: 0, anchor: 'c2' }]);
+  const row = it.list.find((e) => e.name === '생수');
+  assert.equal(I.itemLeft(it, row, alive), 0);
+  assert.equal(I.liveItems(it, alive).length, 1);
+  assert.equal(I.itemLeft(it, row, new Set(['c1'])), 3);
+  // 같은 응답을 다시 읽어도 또 빼지 않는다
+  assert.equal(I.applyItemChanges(it, alive, [{ action: 'update', name: '생수', uses: 0, anchor: 'c2' }]).log.length, it.log.length);
+});
+
+test('Recently: 다 쓴 것은 used up, 상점 「메인 요청에 붙이는 것」을 끈 판 것은 넘기지 않는다', () => {
+  const chat = { message: [msg('user', 'u1'), msg('char', 'c1'), msg('user', 'u2'), msg('char', 'c2')] };
+  const alive = new Set(['u1', 'c1', 'u2', 'c2']);
+  let it = I.addItem(empty, alive, { name: '붕대', uses: 1, from: 'manual', anchor: '' });
+  it = I.applyItemChanges(it, alive, [{ action: 'update', name: '붕대', uses: 0, anchor: 'c1' }]);
+  it = I.addItem(it, alive, { name: '코트', from: 'manual', anchor: '' });
+  it = I.sellItem(it, it.list.find((e) => e.name === '코트').id, 'c2', '철물점에 팖');
+  assert.deepEqual(I.recentItemLog(chat, it, 3, {}), ['used up 붕대', 'sold 코트']);
+  assert.deepEqual(I.recentItemLog(chat, it, 3, { $sh_main_sell: '0' }), ['used up 붕대']);
+});
